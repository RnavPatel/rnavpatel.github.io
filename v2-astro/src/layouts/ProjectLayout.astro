---
/**
 * ProjectLayout.astro — src/layouts/ProjectLayout.astro
 * ============================================================
 * Layout for all project/case-study pages.
 *
 * GRID — same 4 columns as the homepage gallery (lines land on image edges):
 *
 *   | col 1     | col 2      col 3 | col 4   |
 *   | sidebar   | TEXT (2x)        |         |
 *   | meta+TOC  | MEDIA (3x) ─────────────────►
 *
 *   >1000px   4 cols. Sidebar in col 1; TOC sticks while scrolling.
 *   601–1000  3 cols (like the homepage). Header, then meta row, then body.
 *             Text spans 2 cols, media spans 3. TOC hidden.
 *   ≤600      1 col. Everything stacks full width.
 *
 * PAGE SLOTS:
 *   <header slot="header" …>   → title block (cols 2–4, top row)
 *   <div slot="meta">…</div>   → Role / Skills / Team (.p-meta-grid) for col 1
 *   everything else            → article body (cols 2–4)
 *
 * CMD+F GUIDE:
 *   "PROJECT GRID"   → column/area definitions + breakpoints
 *   "TEXT WIDTH"     → --p-text-w, the 2-column text measure
 *   "SIDEBAR"        → col-1 meta + sticky TOC
 *   "SECTION SPACING"→ margin-top on .p-section-open and .p-detail
 *
 * TYPOGRAPHY — only two custom classes needed in project pages:
 *   .label    → small muted uppercase tag above headings  e.g. "Case Study", "Problem"
 *   .caption  → small muted centered text under images
 *   Everything else uses plain HTML: <h1> <h2> <h3> <p>
 *   Sizes/colors for those are set in typography.css and tokens.css.
 *
 * LAYOUT BLOCKS:
 *   .p-section-open  → major narrative beat (Problem, Case Study, Concept…)
 *   .p-detail        → sub-point within a section (Design Goal, UX Flow, Process…)
 *   .p-media         → full-width single image or video
 *   .p-media-2col    → two-column media grid
 *   .p-media-3col    → three-column media grid
 *   .p-not-mine      → "Not my work" pill on an image's top-left (on the img's wrapper div)
 *   .p-media-ph      → DRAFT gray placeholder box (stand-in for an img inside the above)
 *   .p-divider       → horizontal rule between major sections
 *   .p-wip           → "more documentation coming" placeholder
 */

import Nav from "../components/Nav.astro";
import ProjectTOC from "../components/ProjectTOC.astro";
import AboutModal from "../components/AboutModal.astro";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/global.css";
import "../styles/typography.css";

interface Props {
  title?: string;
  description?: string;
  tocItems?: { id: string; label: string }[];
  /** Set on case-study sub-pages to link back up to their project hub page */
  backHref?: string;
  backLabel?: string;
}

const {
  title = "Aarnav Patel",
  description = "Experience designer crafting the future of interactive entertainment.",
  tocItems = [],
  backHref,
  backLabel,
} = Astro.props;

const fullTitle = title === "Aarnav Patel" ? title : `${title} — Aarnav Patel`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Nav activePage="work" backHref={backHref} backLabel={backLabel} />
    <div class={`project-page${backHref ? " project-page--has-back-nav" : ""}`}>
      <div class="p-head">
        <slot name="header" />
      </div>
      <aside class="p-sidebar">
        {Astro.slots.has("meta") && (
          <div class="p-sidebar-meta">
            <slot name="meta" />
          </div>
        )}
        <ProjectTOC items={tocItems} />
      </aside>
      <article class="project-content">
        <slot />
      </article>
    </div>

    <!-- About modal -->
    <div id="about-modal" class="modal-backdrop" aria-hidden="true">
      <div class="modal-panel" role="dialog" aria-modal="true" aria-label="About Aarnav">
        <div class="modal-header">
          <button class="modal-close" aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          <AboutModal />
        </div>
      </div>
    </div>

  </body>
</html>

<script>
  const modal   = document.getElementById('about-modal')!;
  const panel   = modal.querySelector('.modal-panel')!;
  const trigger = document.querySelector('[data-modal="about"]')!;
  const close   = modal.querySelector('.modal-close')!;

  function openModal() {
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', openModal);
  close.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (!panel.contains(e.target as Node)) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style is:global>

  /* Override global.css height:100% — project media must be height:auto */
  .p-head img,
  .p-head video,
  .project-content img,
  .project-content video {
    height: auto;
  }

  /* =============================================
     PROJECT GRID
     Same 4 columns as the homepage gallery. Padding and gap come from
     --grid-inset / --grid-gutter (tokens.css), so column edges land
     exactly on the homepage's image edges.

     Areas:  side = col 1 (meta + TOC)
             head = cols 2–4, title block
             body = cols 2–4, article
     Inside head/body, media fills all 3 columns; text is capped to 2
     (see TEXT WIDTH below), leaving col 4 empty only beside text.
  ============================================= */

  .project-page {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "side head head head"
      "side body body body";
    column-gap: var(--grid-gutter);
    padding-inline: var(--grid-inset);
    padding-top: var(--page-padding-top);
    padding-bottom: var(--space-16);
    /* clip (not hidden) so position: sticky in the sidebar keeps working */
    overflow-x: clip;

    /* TEXT WIDTH — 2 of the 3 columns head/body span.
       cqi = width of .p-head / .project-content (both are containers), so
       this resolves the same at any nesting depth inside them. */
    --p-text-w: calc((100cqi - 2 * var(--grid-gutter)) * 1.75 / 3 + var(--grid-gutter));

    /* TEXT POSITION — see the rule below "Running text" */
    --p-text-margin: auto;
  }

  /* Extra clearance when Nav renders its second "back to hub" pill row */
  .project-page--has-back-nav {
    padding-top: calc(var(--page-padding-top) + 3rem);
  }

  .p-head,
  .project-content {
    container-type: inline-size;
    min-width: 0;
  }

  .p-head          { grid-area: head; }
  .project-content { grid-area: body; }

  /* Tablet — homepage is 3 columns here. Sidebar drops below the title
     block as a row; text still spans 2 of 3 columns, media all 3. */
  @media (max-width: 1000px) {
    .project-page {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto;
      grid-template-areas:
        "head head head"
        "side side side"
        "body body body";
    }
  }

  /* Phone — single column, everything full width */
  @media (max-width: 600px) {
    .project-page {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "side" "body";
      --p-text-w: 100cqi;
    }
  }

  /* Running text never runs wider than 2 columns. Media blocks (and
     anything inside them, e.g. captions, cards) are left at full width. */
  /* (no whitespace between the :is() and :not() — they're one compound) */
  :is(.p-head, .project-content)
    :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote, hr,
        .p-section-open, .p-detail, .p-meta-grid, .p-wip):not(
          .p-media, .p-media-2col, .p-media-3col, .p-card-grid,
          :is(.p-media, .p-media-2col, .p-media-3col, .p-card-grid) *) {
    max-width: var(--p-text-w);
  }

  /* TEXT POSITION — where the text measure sits inside the 3 content cols.
     Set via --p-text-margin on .project-page:
       auto     → centred under the media (current)
       0 auto   → flush left on col 2 (on-grid)
     Only the OUTERMOST text block gets it. Nested ones (a <p> in a
     .p-detail, a .p-detail in a .p-meta-grid) already sit inside a centred
     parent; auto margins there would shrink-wrap them inside flex/grid. */
  :is(.p-head, .project-content)
    :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote, hr,
        .p-section-open, .p-detail, .p-meta-grid, .p-wip):not(
          .p-media, .p-media-2col, .p-media-3col, .p-card-grid,
          :is(.p-media, .p-media-2col, .p-media-3col, .p-card-grid) *,
          :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote,
              .p-section-open, .p-detail, .p-meta-grid, .p-wip) *) {
    margin-inline: var(--p-text-margin);
  }

  /* =============================================
     SIDEBAR — col 1. Meta sits level with the title; the TOC below it
     is sticky (ProjectTOC.astro), so it follows the reader down the page.
  ============================================= */

  .p-sidebar {
    grid-area: side;
    min-width: 0;
    /* matches .p-header padding-top so the first label lines up with the title */
    padding-top: var(--space-8);
  }

  .p-sidebar-meta .p-meta-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .p-sidebar-meta a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .p-sidebar-meta a:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 1000px) {
    .p-sidebar {
      padding-top: 0;
    }

    .p-sidebar-meta {
      padding-bottom: var(--space-8);
    }

    /* One meta item per grid column */
    .p-sidebar-meta .p-meta-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }
  }

  /* =============================================
     TYPOGRAPHY UTILITIES
     Only two custom classes — everything else is a plain HTML element.
  ============================================= */

  /* Small muted uppercase tag above headings — e.g. "Case Study", "Problem" */
  /* margin-top is intentionally 0 — spacing is owned by the parent block
     (.p-section-open, .p-detail, section) not the label itself.           */
  .label {
    display: block;
    border-radius: var(--);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  /* Pill tags — same style as project card tags, for use in the header meta area */
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .tag {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Small muted text under images */
  .caption {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    text-align: center;
  }

  /* =============================================
     TEXT BLOCK SYSTEM — 2 tiers
     SECTION SPACING — edit margin-top values here

     .p-section-open  major narrative beat opener (Problem, Case Study, Concept…)
     .p-detail        sub-point within a section (Design Goal, UX Flow, Process…)
  ============================================= */

  .p-section-open {
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .p-detail {
    margin-top: var(--space-24);
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* =============================================
     MEDIA
  ============================================= */

  .p-media {
    margin-top: var(--space-6);
    margin-bottom: var(--space-16);
  }

  .p-media img,
  .p-media video {
    width: 100%;
    border-radius: var(--radius-md);
    outline: 2px solid var(--color-border);
  }

  .p-media-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gutter);
    margin-top: var(--space-6);
  }


  /* gap = grid gutter, so at 3x wide each tile is exactly one page column */
  .p-media-3col {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--grid-gutter);
    margin-top: var(--space-6);
  }

  .p-media-2col img,
  .p-media-2col video,
  .p-media-3col img,
  .p-media-3col video {
    width: 100%;
    border-radius: var(--radius-md);
  }

  /* "Not my work" pill pinned to the top-left of the image — same look as
     the homepage card tags (.card-tag in ProjectCard.astro). Put it on the
     div that wraps the img (the img must come first, caption after):
       <div class="p-not-mine"><img …><p class="caption">…</p></div> */
  .p-not-mine {
    position: relative;
  }

  .p-not-mine::before {
    content: "Not my work";
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 1;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
  }

  /* DRAFT ONLY — gray stand-in for an img/video while sketching layouts.
     Drop inside .p-media / .p-media-2col / .p-media-3col in place of the img:
       <div class="p-media-ph">Hero shot</div>
     Default 16:9; override with style="aspect-ratio: 1" etc. */
  .p-media-ph {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    outline: 2px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    text-align: center;
  }

  /* =============================================
     CARD GRID — lays out <ProjectCard size="col2"> tiles (e.g. a
     project hub page's case-study links). 2 columns on desktop,
     collapses to a single full-width column on mobile — same
     "cards go full-width" behavior as the homepage gallery, just
     via grid-template-columns instead of flex-wrap.

     Kept separate from .p-media-2col/.p-media-3col on purpose: those
     stay 2/3-up on mobile for plain image pairs, this always stacks.
  ============================================= */
  /* Cards carry --gap-grid padding (as on the homepage), so the grid
     bleeds out by that much to put the card IMAGES on the media edges,
     and the gap makes the visible gutter 3 × --gap-grid. */
  .p-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-grid);
    margin-top: var(--space-6);
    margin-inline: calc(-1 * var(--gap-grid));
    width: calc(100% + 2 * var(--gap-grid));
  }

  @media (max-width: 640px) {
    .p-card-grid {
      grid-template-columns: 1fr;
    }
  }

  /* =============================================
     PROJECT HEADER
  ============================================= */

  .p-header {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* Space between the page title and the meta grid below it */
  .p-header h1 {
    padding-bottom: var(--space-4);
  }

  .p-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 640px) {

    .p-media-2col,
    .p-media-3col {
      grid-template-columns: 1fr 1fr;
    }

    /* Meta grid: always at least 2 columns on mobile */
    .p-meta-grid,
    .p-sidebar-meta .p-meta-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Each <section> owns the breathing room after a .p-divider.
     Labels and .p-section-open inside don't need their own margin-top. */
  .project-content section {
    margin-top: var(--space-12);
  }

  /* Links inside the meta section */
  .p-header a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .p-header a:hover {
    color: var(--color-text-primary);
  }

  /* horizontal rule divider between major case study sections */
  .p-divider {
    border: none;
    border-top: 3px solid var(--color-border);
    margin: var(--space-8) 0 0;
  }

  /* "More documentation coming" placeholder */
  .p-wip {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-8) 0;
    margin-top: var(--space-8);
  }

  /* =============================================
     About modal
  ============================================= */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    box-sizing: border-box;

    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .modal-backdrop.is-open {
    opacity: 1;
    pointer-events: all;
  }

  /* Desktop panel — flex column so header stays fixed and body scrolls */
  .modal-panel {
    position: relative;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 750px;
    max-height: 80svh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;

    transform: translateY(12px);
    transition: transform 200ms ease;
  }

  .modal-backdrop.is-open .modal-panel {
    transform: translateY(0);
  }

  /* Header row — never scrolls, holds the close pill */
  .modal-header {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    padding: var(--space-4) var(--space-4) 0;
  }

  /* Close button styled as a nav pill */
  .modal-close {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-nav-border);
    background-color: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color var(--duration-fast) ease;
    line-height: 1;
  }

  .modal-close:hover {
    background-color: var(--color-nav-hover-bg);
  }

  /* Scrollable content area */
  .modal-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6) var(--space-10) var(--space-10);
    min-height: 0; /* required for flex overflow to work */
  }

  /* Mobile — full-width bottom sheet anchored to the bottom 3/4 of the screen */
  @media (max-width: 640px) {
    .modal-backdrop {
      align-items: flex-end;
      padding: 0;
    }

    .modal-panel {
      width: 100%;
      max-width: 100%;
      max-height: 75svh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border-bottom: none;

      transform: translateY(100%);
    }

    .modal-backdrop.is-open .modal-panel {
      transform: translateY(0);
    }

    .modal-body {
      padding: var(--space-4) var(--space-6) var(--space-8);
    }
  }

</style>
