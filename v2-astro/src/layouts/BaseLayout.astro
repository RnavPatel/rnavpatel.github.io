---
/**
 * BaseLayout.astro  —  src/layouts/BaseLayout.astro
 * ============================================================
 * The HTML shell that every page uses.
 * Imports all global CSS, loads fonts, sets meta tags.
 *
 * MARGIN SYSTEM — how page margins work:
 *   <main> is a CSS Grid with named column lines:
 *
 *   [full-start] [margin] [content-start] [1fr] [content-end] [margin] [full-end]
 *
 *   Every section/element inside <main> sits in "content" by default.
 *   Add class="full-bleed" to any section to make it span edge-to-edge.
 *
 *   The margin width is --page-padding-x in tokens.css.
 *   Change it there to update ALL page margins simultaneously.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Page margin grid"  → the main grid definition (margin system)
 *   "Content column"    → default placement for all sections
 *   "Full bleed"        → class that breaks a section out of the margins
 * ============================================================
 *
 * Usage:
 *   <BaseLayout title="Work">
 *     <section>Normal content — has margins</section>
 *     <section class="full-bleed">This touches the edges</section>
 *   </BaseLayout>
 */

import Nav from "../components/Nav.astro";
import PageTransitions from "../components/PageTransitions.astro";

// Global styles — imported once here, applied everywhere
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/global.css";
import "../styles/typography.css";

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image, relative to /public. */
  image?: string;
}

const {
  title = "Aarnav Patel",
  description = "A product designer who makes joyful interactive experiences across entertainment and education.",
  image = "/images/AarnavHeadshot.png",
} = Astro.props;

const SITE_NAME = "Aarnav Patel";
const fullTitle = title.startsWith(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;

// Absolute URLs built from `site` in astro.config.mjs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Tells Google what to show as the site name above the search result
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PageTransitions />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Link previews (iMessage, LinkedIn, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Site name in Google results -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Host Grotesk — preconnect for faster load, only load weights we use -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Nav />

    <main>
      <slot />
    </main>

  </body>
</html>

<script>
  // Mobile autoplay: IntersectionObserver triggers .play() when videos enter viewport.
  // Required because iOS Safari and Android Chrome ignore the autoplay attribute for
  // off-screen videos and silently show a play button instead.
  const videoObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    },
    { threshold: 0.25 }
  );

  document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
    videoObserver.observe(v);
  });
</script>

<style is:global>
  /* =============================================
     Page margin grid
     Defined once here — controls margins on every page.
     =============================================

     The margin system works by making <main> a CSS Grid
     with named column lines. The two outer columns ARE
     the page margins. Content sits between them.

     To change page margins: edit --page-padding-x in tokens.css.
     Do NOT add horizontal padding to individual sections —
     the grid handles it for you.
  */
  main {
    padding-top: var(--page-padding-top);
    min-height: calc(100svh - var(--nav-height)); /* nav sits above, in flow */

    display: grid;
    grid-template-columns:
      [full-start]    var(--page-padding-x)
      [content-start] 1fr
      [content-end]   var(--page-padding-x)
      [full-end];

    /* Rows size to their content automatically */
    grid-template-rows: auto;

    /* Prevents full-bleed items from causing horizontal scroll */
    overflow-x: clip;
  }


  /* =============================================
     Content column
     Default for every direct child of <main>.
     Sits inside the page margins.
  */
  main > * {
    grid-column: content;
    min-width: 0; /* prevents grid blowout on wide content */
  }

  /* =============================================
     Full bleed
     Add class="full-bleed" to any section to make
     it stretch edge-to-edge, ignoring page margins.
     Use this for hero videos, full-width images,
     and the homepage gallery grid.

     Example:
       <section class="full-bleed">
         <video ...>
       </section>
  */
  main > .full-bleed {
    grid-column: full;
  }

</style>
