---
/**
 * BaseLayout.astro  —  src/layouts/BaseLayout.astro
 * ============================================================
 * The HTML shell that every page uses.
 * Imports all global CSS, loads fonts, sets meta tags.
 *
 * MARGIN SYSTEM — how page margins work:
 *   <main> is a CSS Grid with named column lines:
 *
 *   [full-start] [margin] [content-start] [1fr] [content-end] [margin] [full-end]
 *
 *   Every section/element inside <main> sits in "content" by default.
 *   Add class="full-bleed" to any section to make it span edge-to-edge.
 *
 *   The margin width is --page-padding-x in tokens.css.
 *   Change it there to update ALL page margins simultaneously.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Page margin grid"  → the main grid definition (margin system)
 *   "Content column"    → default placement for all sections
 *   "Full bleed"        → class that breaks a section out of the margins
 * ============================================================
 *
 * Usage:
 *   <BaseLayout title="Work" activePage="work">
 *     <section>Normal content — has margins</section>
 *     <section class="full-bleed">This touches the edges</section>
 *   </BaseLayout>
 */

import Nav from "../components/Nav.astro";
import AboutModal from "../components/AboutModal.astro";

// Global styles — imported once here, applied everywhere
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/global.css";
import "../styles/typography.css";

interface Props {
  title?: string;
  description?: string;
  activePage: "work" | "about";
}

const {
  title = "Aarnav Patel",
  description = "Experience designer crafting the future of interactive entertainment.",
  activePage,
} = Astro.props;

const fullTitle = title === "Aarnav Patel" ? title : `${title} — Aarnav Patel`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->

    <!-- DM Sans — preconnect for faster load, only load weights we use -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100;0,9..40,200;0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900;0,9..40,1000;1,9..40,100;1,9..40,200;1,9..40,300;1,9..40,400;1,9..40,500;1,9..40,600;1,9..40,700;1,9..40,800;1,9..40,900;1,9..40,1000&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Nav activePage={activePage} />

    <main>
      <slot />
    </main>

    <!-- About modal -->
    <div id="about-modal" class="modal-backdrop" aria-hidden="true">
      <div class="modal-panel" role="dialog" aria-modal="true" aria-label="About Aarnav">
        <div class="modal-header">
          <button class="modal-close" aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          <AboutModal />
        </div>
      </div>
    </div>

  </body>
</html>

<script>
  const modal   = document.getElementById('about-modal')!;
  const panel   = modal.querySelector('.modal-panel')!;
  const trigger = document.querySelector('[data-modal="about"]')!;
  const close   = modal.querySelector('.modal-close')!;

  function openModal() {
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', openModal);
  close.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (!panel.contains(e.target as Node)) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Mobile autoplay: IntersectionObserver triggers .play() when videos enter viewport.
  // Required because iOS Safari and Android Chrome ignore the autoplay attribute for
  // off-screen videos and silently show a play button instead.
  const videoObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    },
    { threshold: 0.25 }
  );

  document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
    videoObserver.observe(v);
  });
</script>

<style is:global>
  /* =============================================
     Page margin grid
     Defined once here — controls margins on every page.
     =============================================

     The margin system works by making <main> a CSS Grid
     with named column lines. The two outer columns ARE
     the page margins. Content sits between them.

     To change page margins: edit --page-padding-x in tokens.css.
     Do NOT add horizontal padding to individual sections —
     the grid handles it for you.
  */
  main {
    padding-top: var(--page-padding-top);
    min-height: 100svh;

    display: grid;
    grid-template-columns:
      [full-start]    var(--page-padding-x)
      [content-start] 1fr
      [content-end]   var(--page-padding-x)
      [full-end];

    /* Rows size to their content automatically */
    grid-template-rows: auto;

    /* Prevents full-bleed items from causing horizontal scroll */
    overflow-x: clip;
  }

  /* =============================================
     Content column
     Default for every direct child of <main>.
     Sits inside the page margins.
  */
  main > * {
    grid-column: content;
    min-width: 0; /* prevents grid blowout on wide content */
  }

  /* =============================================
     Full bleed
     Add class="full-bleed" to any section to make
     it stretch edge-to-edge, ignoring page margins.
     Use this for hero videos, full-width images,
     and the homepage gallery grid.

     Example:
       <section class="full-bleed">
         <video ...>
       </section>
  */
  main > .full-bleed {
    grid-column: full;
  }

  /* =============================================
     About modal
  ============================================= */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    box-sizing: border-box;

    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .modal-backdrop.is-open {
    opacity: 1;
    pointer-events: all;
  }

  /* Desktop panel — flex column so header stays fixed and body scrolls */
  .modal-panel {
    position: relative;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 750px;
    max-height: 80svh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;

    transform: translateY(12px);
    transition: transform 200ms ease;
  }

  .modal-backdrop.is-open .modal-panel {
    transform: translateY(0);
  }

  /* Header row — never scrolls, holds the close pill */
  .modal-header {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    padding: var(--space-4) var(--space-4) 0;
  }

  /* Close button styled as a nav pill */
  .modal-close {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-nav-border);
    background-color: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color var(--duration-fast) ease;
    line-height: 1;
  }

  .modal-close:hover {
    background-color: var(--color-nav-hover-bg);
  }

  /* Scrollable content area */
  .modal-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6) var(--space-10) var(--space-10);
    min-height: 0; /* required for flex overflow to work */
  }

  /* Mobile — full-width bottom sheet anchored to the bottom 3/4 of the screen */
  @media (max-width: 640px) {
    .modal-backdrop {
      align-items: flex-end;
      padding: 0;
    }

    .modal-panel {
      width: 100%;
      max-width: 100%;
      max-height: 75svh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      border-bottom: none;

      transform: translateY(100%);
    }

    .modal-backdrop.is-open .modal-panel {
      transform: translateY(0);
    }

    .modal-body {
      padding: var(--space-4) var(--space-6) var(--space-8);
    }
  }
</style>
