---
/**
 * ProjectCard.astro  —  src/components/ProjectCard.astro
 * ============================================================
 * A single project tile in the homepage gallery grid.
 *
 * TWO CARD SIZES:
 *   "square"  →  aspect-ratio: 1/1  (spans 1 column)
 *   "wide"    →  aspect-ratio: 2/1  (spans 2 columns)
 *   The 2:1 ratio is intentional: a wide card spanning 2 columns
 *   ends up the same HEIGHT as a square card in 1 column.
 *   On mobile, both become 16:9 (controlled in index.astro).
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Card shape"      → border-radius, aspect ratios per size
 *   "Media"           → image/video fill and zoom-on-hover
 *   "Caption"         → the title+tags overlay that appears on hover
 *   "Gradient"        → the dark-to-transparent gradient behind text
 *   "Tags style"      → font, color, spacing of the tag line
 *   "Hover state"     → what changes when mouse enters the card
 *   "Mobile caption"  → how caption looks on touch screens
 * ============================================================
 *
 * To change appearance: edit the <style> block below
 * To change content (title, tags, image): edit src/data/projects.ts
 */

interface Props {
  title: string;
  tags: string[];
  href: string;
  image: string;
  mediaType: "image" | "video";
  size: "square" | "wide";
  gridArea: string;
}

const { title, tags, href, image, mediaType, size, gridArea } = Astro.props;

const style = `grid-area: ${gridArea};`;
---

<article class={`card card--${size}`} style={style}>
  <a href={href} class="card-link">

    <!-- ---- Media ---- -->
    <div class="card-media">
      {image && mediaType === "video" && (
        <video autoplay muted loop playsinline>
          <source src={image} type="video/mp4" />
        </video>
      )}
      {image && mediaType === "image" && (
        <img src={image} alt={title} loading="lazy" />
      )}
      <!-- No image → gray from background shows through -->
    </div>

    <!-- ---- Caption (hover overlay) ---- -->
    <div class="card-caption">
      <p class="card-title">{title}</p>
      <p class="card-tags">{tags.join(" · ")}</p>
    </div>

  </a>
</article>

<style>
  /* =============================================
     Card shape
     ============================================= */
  .card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  /* Square card: 1:1. Width = 1 column. */
  .card--square {
    aspect-ratio: 1 / 1;
  }

  /* Wide card: 2:1. Width = 2 columns.
     The 2:1 ratio is matched to the 4-column grid so that
     a wide card (2 cols) is the same HEIGHT as a square card (1 col).
     Math: if 1 col = W, wide card = 2W, height = 2W÷2 = W. Equal. */
  .card--wide {
    aspect-ratio: 2 / 1;
  }

  /* card-link must fill the card completely for the hover area to work */
  .card-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* =============================================
     Media (image or video fill)
     ============================================= */
  .card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .card-media img,
  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;   /* crops to fit — never squishes */
    display: block;
    transition: transform var(--duration-slow) var(--ease-out-expo);
    will-change: transform;
  }

  /* =============================================
     Caption (the hover overlay: title + tags)
     ============================================= */
  .card-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: var(--space-5);
    /* Gradient */
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.2)  40%,
      transparent         70%
    );
    opacity: 0;
    transform: translateY(var(--space-2));
    transition:
      opacity   var(--duration-normal) var(--ease-out-quart),
      transform var(--duration-normal) var(--ease-out-quart);
    pointer-events: none;
  }

  /* =============================================
     Tags style
     ============================================= */
  .card-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-inverse);
    line-height: var(--leading-tight);
  }

  .card-tags {
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* =============================================
     Hover state (desktop / mouse only)
     ============================================= */
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card-media img,
    .card:hover .card-media video {
      transform: scale(1.04);
    }

    .card:hover .card-caption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =============================================
     Mobile caption (touch screens)
     Always visible, sits below the image
     ============================================= */
  @media (hover: none), (max-width: 768px) {
    .card-caption {
      position: static;
      background: none;
      padding: var(--space-3) var(--space-2);
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .card-title { color: var(--color-text-primary); }
    .card-tags  { color: var(--color-text-muted); }
  }
</style>
