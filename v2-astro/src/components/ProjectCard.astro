---
/**
 * ProjectCard.astro  —  src/components/ProjectCard.astro
 * ============================================================
 * A single project tile in the homepage gallery grid.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Card shape"     → border-radius, width, aspect ratio per size
 *   "Media"          → image/video fill and zoom-on-hover
 *   "Caption"        → the overlay that appears on hover
 *   "Gradient"       → dual gradient (dark top + dark bottom)
 *   "Tag pills"      → the individual white pill badges at the top
 *   "Title style"    → the bold white title below the image
 *   "Title row"      → title + optional status chip pushed right
 *   "Hover state"    → what animates when mouse enters the card
 *   "Jump"           → the space-bar hop across every card
 * ============================================================
 *
 * To change appearance: edit the <style> block below
 * To change content (title, tags, image): edit src/data/projects.ts
 */

import StatusChip, { type Status } from "./StatusChip.astro";

interface Props {
  title: string;
  tags: string[];
  href: string;
  image: string;
  mediaType: "image" | "video";
  /** "square"/"wide" = homepage gallery tiles (sized off --col-unit).
   *  "col2" = fills one column of a 2-column CSS grid (e.g. a project
   *  hub page's case-study grid) — sizes itself off its grid cell
   *  instead of --col-unit, and stacks full-width on mobile. */
  size: "square" | "wide" | "col2";
  subtitle?: string;
  locked?: boolean;
  status?: Status;
}

const { title, subtitle, tags, href, image, mediaType, size, locked, status } = Astro.props;
---

<!-- Wrapper <a> is the clickable element — covers both image and title below -->
<a href={href} class={`card-wrapper card--${size}${locked ? ' card--locked' : ''}`}>

  <!-- ---- Image area: fixed size, clips media and overlays ---- -->
  <div class="card-image-area" data-jump>

    <!-- Media (image or video) -->
    <div class="card-media">
      {image && mediaType === "video" && (
        <video autoplay muted loop playsinline>
          <source src={image} type="video/mp4" />
        </video>
      )}
      {image && mediaType === "image" && (
        <img src={image} alt={title} loading="lazy" />
      )}
    </div>

    <!-- Tag pills overlay — top of card on hover -->
    {tags.length > 0 && (
      <div class="card-caption">
        <div class="card-tag-row">
          {tags.map(tag => (
            <span class="card-tag">{tag}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Mobile lock badge — always visible on touch screens -->
    {locked && <span class="card-lock-badge">🔒</span>}

  </div>

  <!-- ---- Title below the image, always visible ---- -->
  <div class="card-text-box">
    <div class="card-title-row">
      <p class="card-title">{locked ? `🔒 ${title}` : title}</p>
      {status && <StatusChip status={status} />}
    </div>
    {subtitle && <p class="card-subtitle">{subtitle}</p>}
  </div>

</a>

<style>
  /* =============================================
     Card shape
     Width is driven by --col-unit set on .gallery in index.astro.

     Desktop/tablet: square and wide cards keep their original
     dimensions. The image area holds the fixed size; the title
     sits below it as plain text.

     Mobile (≤ 600px): index.astro collapses both sizes to
     width:100% / aspect-ratio:16/9 on the wrapper. We reset the
     wrapper's aspect-ratio (it now contains title text too) and
     apply 16/9 to .card-image-area instead.
  ============================================= */

  /* Wrapper is the link — flex column: image on top, title below */
  .card-wrapper {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    text-decoration: none;
    border-radius: var(--radius-sm);
    color: inherit;
    padding: var(--gap-grid);
  }

  .card-wrapper:hover {
    background-color: var(--color-surface);
  }

  /* Square: 1 column unit wide */
  .card--square {
    width: var(--col-unit);
  }

  /* Wide: 2 column units wide */
  .card--wide {
    width: calc(2 * var(--col-unit) + var(--gap-grid));
  }

  /* Col2: fills one cell of a 2-column CSS grid (not --col-unit based —
     the grid it sits in already owns the column math). */
  .card--col2 {
    width: 100%;
  }

  /* ---- Image area: fixed size, clips media and overlays ---- */
  .card-image-area {
    position: relative;
    overflow: hidden;
    background-color: var(--color-surface);
    flex-shrink: 0;
    border-radius: var(--radius-sm);
  }

  /* Square image area: same explicit height as wide (1 col-unit via cqi),
     so wrapper padding never skews the height the way aspect-ratio would. */
  .card--square .card-image-area {
    height: calc((100cqi - 3 * var(--gap-grid)) / 4);
  }

  /* Wide image area: same height as a square card.
     Desktop (4-column): height = (gallery-width - 3 gaps) / 4 = col-unit */
  .card--wide .card-image-area {
    height: calc((100cqi - 3 * var(--gap-grid)) / 4);
  }

  /* Col2 image area: aspect-ratio based instead of cqi — col2 isn't
     necessarily inside the homepage's --col-unit/container-query context,
     so it sizes off its own width instead of the gallery container. */
  .card--col2 .card-image-area {
    height: auto;
    aspect-ratio: 16 / 9;
  }

  /* Tablet (601–1000px): 3-column grid */
  @media (max-width: 1000px) and (min-width: 601px) {
    .card--wide .card-image-area {
      height: calc((100cqi - 2 * var(--gap-grid)) / 3);
    }
  }

  /* =============================================
     Media (image or video fill)
  ============================================= */
  .card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
  }

  .card-media img,
  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out-expo);
    will-change: transform;
    border-radius: var(--radius-sm);
  }

  /* =============================================
     Caption
     Tag-pills overlay at the top of the image on hover.
  ============================================= */
  .card-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: var(--space-4);

    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      transparent          40%
    );

    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out-quart);
    pointer-events: none;
  }

  /* =============================================
     Tag pills  (top of card on hover)
  ============================================= */
  .card-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .card-tag {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    white-space: nowrap;
  }

  /* =============================================
     Title style  (below the image, always visible)
  ============================================= */
  .card-text-box {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    gap: var(--space-1);
  }

  /* Title row — title on the left, status chip pushed to the right edge.
     Chip is optional; without it the title just sits alone. */
  .card-title-row {
    display: flex;
    align-items: center;
    /* justify-content: space-between; */
    gap: var(--space-2);
  } 
  @media (max-width: 600px) {
    .card-title-row {
      justify-content: space-between;
    }
  }

  .card-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    line-height: var(--leading-normal);
  }

  .card-subtitle {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }


  /* =============================================
     Lock badge  (mobile only — on top of the image)
  ============================================= */
  .card-lock-badge {
    display: none;
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    pointer-events: none;
  }

  /* =============================================
     Hover state  (desktop / mouse only)
  ============================================= */
  @media (hover: hover) and (pointer: fine) {
    .card-wrapper:hover .card-media img,
    .card-wrapper:hover .card-media video {
      transform: scale(1.04);
    }

    .card-wrapper:hover .card-caption {
      opacity: 1;
    }
  }

  /* =============================================
     Jump
     Pressing space makes every card's image hop (see <script> below +
     src/motion/springs.ts). JS writes these numbers; CSS decides
     what they mean:
       --jump-y     vertical hop in px (rests at 0, negative = up)
       --jump-s     slight stretch mid-hop (rests at 1)
       --jump-lift  0→1, drives the shadow so it reads as lifting off
  ============================================= */
  .card-image-area {
    transform: translateY(var(--jump-y, 0px)) scale(var(--jump-s, 1));
    box-shadow: 0
      calc(var(--jump-lift, 0) * 10px)
      calc(var(--jump-lift, 0) * 24px)
      rgba(0, 0, 0, calc(var(--jump-lift, 0) * 0.18));
  }

  /* While hopping, lift the card above its neighbours so the
     scaled image overlaps them instead of tucking under. */
  .card-wrapper[data-jump-active] {
    position: relative;
    z-index: 1;
  }

  /* =============================================
     Mobile (≤ 600px)
     index.astro sets width:100% / aspect-ratio:16/9 on the wrapper.
     Reset wrapper's aspect-ratio (it has title text below the image)
     and apply 16/9 to the image area only.
  ============================================= */
  @media (max-width: 600px) {
    .card-wrapper {
      aspect-ratio: unset !important;
      height: auto !important;
    }

    .card-image-area,
    .card--square .card-image-area,
    .card--wide .card-image-area {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .card-caption {
      display: none;
    }

    .card-lock-badge {
      display: block;
    }
  }
</style>

<script>
  import { Spring, springs } from "../motion/springs";

  /* Jump tuning.
     JUMP_KICK is upward velocity: peak ≈ 210 / √300 ≈ 12px up, then it
     bounces back down past rest a few times. JUMP_STAGGER ripples the
     hop across the grid card-by-card (set to 0 for all-at-once). */
  const JUMP_KICK = -210;
  const SCALE_KICK = 0.4;    // little stretch mid-hop
  const JUMP_STAGGER = 45;   // ms between each card's hop
  const JUMP_PEAK = Math.abs(JUMP_KICK) / Math.sqrt(springs.jelly.stiffness / springs.jelly.mass);

  const jumps: (() => void)[] = [];

  document.querySelectorAll<HTMLElement>("[data-jump]").forEach((image) => {
    const card = image.closest<HTMLElement>(".card-wrapper")!;

    const render = () => {
      image.style.setProperty("--jump-y", `${jump.value.toFixed(2)}px`);
      image.style.setProperty("--jump-s", scale.value.toFixed(4));
      image.style.setProperty("--jump-lift", Math.max(0, -jump.value / JUMP_PEAK).toFixed(3));
    };

    // Drop back under the neighbours only once both springs have settled.
    const settle = () => {
      if ([jump, scale].every((sp) => sp.velocity === 0 && sp.value === sp.target)) {
        card.removeAttribute("data-jump-active");
      }
    };

    const jump  = new Spring(0, springs.jelly, render, settle);
    const scale = new Spring(1, springs.jelly, render, settle);

    jumps.push(() => {
      card.setAttribute("data-jump-active", "");
      jump.kick(JUMP_KICK);
      scale.kick(SCALE_KICK);
    });
  });

  // Space bar — but leave space alone wherever it already means something
  // (typing, pressing a focused button/link, an open modal).
  window.addEventListener("keydown", (e) => {
    if (e.code !== "Space" || e.repeat) return;
    const target = e.target;
    if (target instanceof Element && target.closest("input, textarea, select, button, a, [contenteditable]")) return;
    if (document.querySelector(".is-open")) return;
    e.preventDefault();   // otherwise space scrolls the page down
    jumps.forEach((hop, i) => setTimeout(hop, i * JUMP_STAGGER));
  });
</script>
