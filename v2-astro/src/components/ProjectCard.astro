---
/**
 * ProjectCard.astro  —  src/components/ProjectCard.astro
 * ============================================================
 * A single project tile in the homepage gallery grid.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Card shape"     → border-radius, width, aspect ratio per size
 *   "Media"          → image/video fill and zoom-on-hover
 *   "Caption"        → the overlay that appears on hover
 *   "Gradient"       → dual gradient (dark top + dark bottom)
 *   "Tag pills"      → the individual white pill badges at the top
 *   "Title style"    → the bold white title at the bottom
 *   "Hover state"    → what animates when mouse enters the card
 *   "Mobile caption" → how caption looks on touch screens
 * ============================================================
 *
 * To change appearance: edit the <style> block below
 * To change content (title, tags, image): edit src/data/projects.ts
 */

interface Props {
  title: string;
  tags: string[];
  href: string;
  image: string;
  mediaType: "image" | "video";
  size: "square" | "wide";
}

const { title, tags, href, image, mediaType, size } = Astro.props;
---

<article class={`card card--${size}`}>
  <a href={href} class="card-link">

    <!-- ---- Media (image or video) ---- -->
    <div class="card-media">
      {image && mediaType === "video" && (
        <video autoplay muted loop playsinline>
          <source src={image} type="video/mp4" />
        </video>
      )}
      {image && mediaType === "image" && (
        <img src={image} alt={title} loading="lazy" />
      )}
    </div>

    <!-- ---- Caption (hover overlay) ---- -->
    <div class="card-caption">

      <!-- Tag pills — top of card -->
      {tags.length > 0 && (
        <div class="card-tag-row">
          {tags.map(tag => (
            <span class="card-tag">{tag}</span>
          ))}
        </div>
      )}

      <!-- Title — bottom of card -->
      <p class="card-title">{title}</p>

    </div>

  </a>
</article>

<style>
  /* =============================================
     Card shape
     Width is driven by --col-unit set on .gallery in index.astro.
     Cards inherit that variable and compute their own width.

     Height:
       Square uses aspect-ratio: 1/1 → height = width = col-unit. ✓
       Wide cannot use aspect-ratio: 2/1 because its width includes
       an extra gap term (+ var(--gap-grid)), which makes height
       come out as col-unit + gap/2 — slightly taller than the square.
       Instead, wide uses height: calc((100cqi - N*gap) / cols),
       which is col-unit expressed as an absolute length via the
       gallery container (set up with container-type in index.astro).
       cqi = container inline size → resolves to px, safe in height.
  ============================================= */
  .card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
    flex-shrink: 0;
  }

  /* Square: 1 column unit wide, 1:1 ratio */
  .card--square {
    width: var(--col-unit);
    aspect-ratio: 1 / 1;
  }

  /* Wide: 2 column units wide, same height as square.
     Desktop (4-column): height = (gallery-width - 3 gaps) / 4 = col-unit */
  .card--wide {
    width: calc(2 * var(--col-unit) + var(--gap-grid));
    height: calc((100cqi - 3 * var(--gap-grid)) / 4);
  }

  /* Tablet (601–1000px): 3-column grid, recalculate col-unit height */
  @media (max-width: 1000px) and (min-width: 601px) {
    .card--wide {
      height: calc((100cqi - 2 * var(--gap-grid)) / 3);
    }
  }

  .card-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* =============================================
     Media (image or video fill)
  ============================================= */
  .card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .card-media img,
  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out-expo);
    will-change: transform;
  }

  /* =============================================
     Caption
     Covers the full card. Uses space-between to push
     tag pills to the top and title to the bottom.
  ============================================= */
  .card-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* tags ↑ top,  title ↓ bottom */
    padding: var(--space-4);

    /* Gradient — dark at top (for tags) AND dark at bottom (for title) */
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,     /* dark at top — behind tag pills */
      transparent          35%,
      transparent          60%,
      rgba(0, 0, 0, 0.70) 100%    /* dark at bottom — behind title */
    );

    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out-quart);
    pointer-events: none;
  }

  /* =============================================
     Tag pills  (top of card on hover)
     Each tag is its own white rounded pill badge.
     To change pill color: edit background below.
     To change pill font: edit font-size / font-weight below.
  ============================================= */
  .card-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .card-tag {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    white-space: nowrap;
  }

  /* =============================================
     Title style  (bottom of card on hover)
     Bold white text at the bottom of the card.
     To change size: edit font-size.
     To change weight: edit font-weight.
  ============================================= */
  .card-title {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-text-inverse);
    line-height: var(--leading-tight);
  }

  /* =============================================
     Hover state  (desktop / mouse only)
  ============================================= */
  @media (hover: hover) and (pointer: fine) {
    /* Image zooms slightly */
    .card:hover .card-media img,
    .card:hover .card-media video {
      transform: scale(1.04);
    }

    /* Caption fades in */
    .card:hover .card-caption {
      opacity: 1;
    }
  }

  /* =============================================
     Mobile caption  (touch screens, ≤ 768px)
     Caption sits below the image as plain text —
     no overlay, always visible.
  ============================================= */
  @media (hover: none), (max-width: 768px) {
    .card-caption {
      position: static;
      background: none;
      padding: var(--space-3) var(--space-2);
      opacity: 1;
      pointer-events: auto;
    }

    .card-tag {
      background: var(--color-surface);
      color: var(--color-text-secondary);
    }

    .card-title {
      color: var(--color-text-primary);
    }
  }
</style>
