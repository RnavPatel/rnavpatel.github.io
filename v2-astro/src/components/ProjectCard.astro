---
/**
 * ProjectCard.astro  —  src/components/ProjectCard.astro
 * ============================================================
 * A single project tile in the homepage gallery grid.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Card shape"      → border-radius, background color
 *   "Media"           → image/video fill and zoom-on-hover
 *   "Caption"         → the title+tags overlay that appears on hover
 *   "Gradient"        → the dark-to-transparent gradient behind text
 *   "Tags style"      → font, color, spacing of the tag line
 *   "Hover state"     → what changes when mouse enters the card
 *   "Mobile caption"  → how caption looks on touch screens
 * ============================================================
 *
 * To change this card's appearance:
 *   - Edit the <style> block at the bottom of this file
 *   - Colors and sizes should reference tokens, e.g. var(--radius-lg)
 *
 * To change project content (title, tags, image):
 *   - Edit src/data/projects.ts — never edit this file for content
 */

interface Props {
  title: string;
  tags: string[];
  href: string;
  image: string;
  mediaType: "image" | "video";
  gridArea: string;
}

const { title, tags, href, image, mediaType, gridArea } = Astro.props;

// Inline style sets which grid cell this card occupies.
// The actual grid area names are defined in src/pages/index.astro
const style = `grid-area: ${gridArea};`;
---

<article class="card" style={style}>
  <a href={href} class="card-link">

    <!-- ---- Media ---- -->
    <div class="card-media">
      {image && mediaType === "video" && (
        <video autoplay muted loop playsinline>
          <source src={image} type="video/mp4" />
        </video>
      )}
      {image && mediaType === "image" && (
        <img src={image} alt={title} loading="lazy" />
      )}
      <!-- No image → gray background from .card shows through -->
    </div>

    <!-- ---- Caption (hover overlay) ---- -->
    <div class="card-caption">
      <p class="card-title">{title}</p>
      <p class="card-tags">{tags.join(" · ")}</p>
    </div>

  </a>
</article>

<style>
  /* =============================================
     Card shape
     ============================================= */
  .card {
    position: relative;
    border-radius: var(--radius-lg);   /* ← change card corners in tokens.css */
    overflow: hidden;
    background-color: var(--color-surface); /* ← gray placeholder; disappears when image loads */
  }

  .card-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* =============================================
     Media (image or video fill)
     ============================================= */
  .card-media {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .card-media img,
  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;    /* fills the card, crops rather than squishing */
    display: block;
    /* Zoom animation is triggered by hover state below */
    transition: transform var(--duration-slow) var(--ease-out-expo);
    will-change: transform;
  }

  /* =============================================
     Caption (the title + tags overlay)
     ============================================= */
  .card-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;   /* pins text to the bottom */
    gap: var(--space-1);
    padding: var(--space-5);
    /* Gradient — dark at bottom fading to transparent at top */
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,     /* ← increase first number to darken gradient */
      rgba(0, 0, 0, 0.2)  40%,
      transparent         70%
    );
    /* Hidden by default; revealed on hover */
    opacity: 0;
    transform: translateY(var(--space-2));   /* starts 8px lower */
    transition:
      opacity   var(--duration-normal) var(--ease-out-quart),
      transform var(--duration-normal) var(--ease-out-quart);
    pointer-events: none;
  }

  /* =============================================
     Tags style
     ============================================= */
  .card-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-inverse);
    line-height: var(--leading-tight);
  }

  .card-tags {
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: rgba(255, 255, 255, 0.65);  /* ← adjust opacity to taste */
    letter-spacing: 0.06em;
    text-transform: uppercase;         /* ← remove this line for mixed case */
  }

  /* =============================================
     Hover state  (desktop / mouse only)
     ============================================= */
  @media (hover: hover) and (pointer: fine) {
    /* Image zooms in */
    .card:hover .card-media img,
    .card:hover .card-media video {
      transform: scale(1.04);   /* ← increase for more zoom, decrease for less */
    }

    /* Caption rises into view */
    .card:hover .card-caption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =============================================
     Mobile caption  (touch screens / small screens)
     Caption always visible, shown below the image
     ============================================= */
  @media (hover: none), (max-width: 768px) {
    .card-caption {
      position: static;       /* detaches from overlay, becomes a block below the image */
      background: none;
      padding: var(--space-3) var(--space-2);
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .card-title {
      color: var(--color-text-primary);
    }

    .card-tags {
      color: var(--color-text-muted);
    }
  }
</style>
