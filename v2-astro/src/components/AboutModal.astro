---
/**
 * AboutModal.astro — src/components/AboutModal.astro
 * ============================================================
 * Content for the About modal overlay.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Bio"        → the paragraph of intro text
 *   "Meta grid"  → the 4-column role/skills/etc grid
 *   "Experience" → the experience rows
 *   "Links"      → email / linkedin at the bottom
 * ============================================================
 *
 * Layout classes mirror ProjectLayout (.p-meta-grid, .p-section-open, .label)
 * but are redefined here as scoped styles since BaseLayout doesn't load
 * ProjectLayout's globals.
 */
---

<!-- Photo + content side by side -->
<div class="about-content">

    <!-- Bio -->
    <div class="p-section-open">
      <h3 class="about-bio">
        Aarnav is a product designer who is inspired by entertainment. 
        <span style="font-weight: var(--weight-regular)">
          He believes interaction can connect people just like a movie, and has seen it firsthand in his work across indie videogames to digital products. 
          He prototypes constantly, and is always picking up new tools to add to his design arsenal.
          <!-- He is empowered by building out his ideas and is constantly learning new tools to refine his design process. -->
          He is also an avid lover of cinemas, learning new wombos, and nothingcore.
          Feel free to reach out!
        </span>
      </h3>
  </div>

    <!-- Meta grid -->
    <div class="label" style="margin-top: var(--space-10)">Contact: </div>
    <div class="about-links">
      <a href="mailto:aarnavpatel2003@gmail.com" class="link">Email</a>
      <a href="https://www.linkedin.com/in/aarnav-patel-ba397b244/" target="_blank" rel="noopener" class="link">LinkedIn</a>
    </div>


  </div>
</div>

<style>

  /* Type — everything in the modal is one size, --text-md.
     The h3 needs its own rule since typography.css sizes h3
     directly (it wouldn't inherit from .about-content). */
  .about-content {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
  }

  /* Browser default for <strong> is 700 — keep to the 400/500/600 set. */
  .about-content strong {
    font-weight: var(--weight-semibold);
  }

  .about-bio {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-loose);
  }

  /* mirrors ProjectLayout .p-section-open */
  .p-section-open {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* mirrors ProjectLayout .p-meta-grid */
  .p-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-6);
  }

  /* mirrors ProjectLayout .label */
  .label {
    display: block;
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  /* mirrors ProjectLayout .p-divider */
  .p-divider {
    border: none;
    border-top: 2px solid var(--color-border);
    margin: 0;
  }

  .about-experience {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .row-rule {
    border: none;
    height: 1px;
    background-color: var(--color-border);
  }

  .about-links {
    display: flex;
    gap: var(--space-5);
  }

  @media (max-width: 640px) {
    .about-inner {
      grid-template-columns: 1fr;
    }

    .about-photo {
      aspect-ratio: 1 / 1;
      max-width: 240px;
    }

    .p-meta-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
