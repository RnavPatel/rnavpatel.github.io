---
/**
 * Nav.astro  —  src/components/Nav.astro
 * ============================================================
 * Top navigation: Work/About pills, plus an optional "< Back" pill
 * on case-study sub-pages. Aligns to the same page margins as all
 * other content.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Nav layout"   → how the bar is positioned and spaced
 *   "Nav links"    → the shared .nav-link pill style (Work, About, Back)
 *   "Hover"        → mouse-over state
 * ============================================================
 *
 * To restyle every nav pill at once: edit .nav-link below
 * To change pill colors: edit --color-nav-bg and --color-nav-border in tokens.css
 */

interface Props {
  activePage: "work" | "about";
  /** Set on case-study sub-pages to render a "← Back to [Project]" pill
   *  as its own row directly under the primary Work/About row. */
  backHref?: string;
  backLabel?: string;
}

const { activePage, backHref, backLabel } = Astro.props;
---

<nav>

  <div class="nav-row">
    <!-- Work / About pills -->
    <div class="nav-links">
      <a href="/" class="nav-link">
        <span>Work</span>
      </a>
      <button data-modal="about" class="nav-link">
        <span>About</span>
      </button>
    </div>
  </div>

  <!-- Back pill — second row, only on case-study sub-pages -->
  {backHref && (
    <a href={backHref} class="nav-link">
      <span>&lt; {backLabel}</span> 
      {/* < symbol = &lt; */}
    </a>
  )}

</nav>

<style>
  /* =============================================
     Nav layout
     Fixed bar across the top holding the Work/About
     group, with the optional Back pill on a second row.
     Padding matches --page-padding-x so pills align
     to the same edges as the gallery content below.
  ============================================= */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;   /* stacks .nav-row above the optional back pill */
    align-items: center;      /* centers both rows horizontally */
    gap: var(--space-2);

    padding: var(--space-3) var(--page-padding-x);
    pointer-events: none; /* bar itself doesn't capture clicks */
  }

  /* Primary row — holds the Work/About group. Explicit width:100% since
     nav's align-items:center would otherwise shrink it to its content. */
  .nav-row {
    display: flex;
    justify-content: center;   /* centers the Work/About group horizontally */
    align-items: center;
    width: 100%;
  }

  /* =============================================
     Nav links
     .nav-link is the one shared pill style for every
     nav button: Work, About, and the Back pill.
  ============================================= */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    pointer-events: all;
  }

  .nav-link {
    appearance: none;
    background: none;
    cursor: pointer;
    pointer-events: all;   /* re-enable clicks — nav itself has pointer-events:none */
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    /* border-radius: var(--radius-pill); */
    border-radius: 4px;
    text-decoration: none;
    border: none;   /* <button> ships with a default outset border; <a> doesn't */

    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background-color: transparent;
    backdrop-filter: blur(12px);          /* frosted blur of whatever scrolls behind */
    -webkit-backdrop-filter: blur(12px);  /* Safari */

    transition: background-color var(--duration-fast) ease;
  }

  /* =============================================
     Hover
  ============================================= */
  .nav-link:hover {
    background-color: var(--color-surface-raised);
    text-decoration: none;
  }
</style>
