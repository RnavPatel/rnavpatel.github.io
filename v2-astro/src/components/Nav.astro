---
/**
 * Nav.astro  —  src/components/Nav.astro
 * ============================================================
 * Top navigation: tagline pill on the left, work/about on the right.
 * Aligns to the same page margins as all other content.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Nav layout"   → how the bar is positioned and spaced
 *   "Tagline pill" → the left "Aarnav is a Design Engineer" pill
 *   "Nav links"    → the right work/about pills
 *   "Hover"        → mouse-over state
 * ============================================================
 *
 * To change the tagline text: edit the <span> in .nav-tagline below
 * To change pill colors: edit --color-nav-bg and --color-nav-border in tokens.css
 */

interface Props {
  activePage: "work" | "about";
  /** Set on case-study sub-pages to render a "← Back to [Project]" pill
   *  as its own row directly under the primary Work/About row. */
  backHref?: string;
  backLabel?: string;
}

const { activePage, backHref, backLabel } = Astro.props;
---

<nav>

  <div class="nav-row">
    <!-- Tagline pill — left side -->
    <!-- <a href="/" class="nav-tagline">
      <span>Work</span>
    </a> -->

    <!-- Work / About pills — right side -->
    <div class="nav-links">
      <a href="/" class="nav-tagline">
        <span>Work</span>
      </a>
      <button data-modal="about" class="nav-link">
        <span>About</span>
      </button>
    </div>
  </div>

  <!-- Back pill — second row, only on case-study sub-pages -->
  {backHref && (
    <a href={backHref} class="nav-link nav-back">
      <span>&lt; {backLabel}</span> 
      {/* < symbol = &lt; */}
    </a>
  )}

</nav>

<style>
  /* =============================================
     Nav layout
     Fixed bar across the top. Pushes tagline to the
     left and the work/about group to the right.
     Padding matches --page-padding-x so pills align
     to the same edges as the gallery content below.
  ============================================= */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;   /* stacks .nav-row above the optional back pill */
    gap: var(--space-2);

    padding: var(--space-3) var(--page-padding-x);
    pointer-events: none; /* bar itself doesn't capture clicks */
  }

  /* Primary row — left pill ←————→ right pills. Explicit width:100% since
     nav's flex-direction:column would otherwise stretch it (fine here,
     but .nav-back below relies on the same stretch unless overridden). */
  .nav-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }

  /* =============================================
     Tagline pill  (left side)
     Shared pill shape with the nav-link style.
  ============================================= */
  .nav-tagline {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-nav-border);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    background-color: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: all;
    transition: background-color var(--duration-fast) ease;
  }

  .nav-tagline:hover {
    background-color: var(--color-nav-hover-bg);
    text-decoration: none;
  }

  /* =============================================
     Nav links  (right side)
     Two pills grouped in a flex row.
  ============================================= */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    pointer-events: all;
  }

  .nav-link {
    appearance: none;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-nav-border);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    background-color: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: all;
    transition: background-color var(--duration-fast) ease;
  }

  /* Back pill — second nav row, sits directly under the primary row.
     align-self overrides nav's stretch so it hugs its own content
     instead of spanning the full bar width like .nav-row does. */
  .nav-back {
    align-self: flex-start;
    text-decoration: none;
  }

  /* =============================================
     Hover
  ============================================= */
  .nav-link:hover {
    background-color: var(--color-nav-hover-bg);
    text-decoration: none;
  }
</style>
