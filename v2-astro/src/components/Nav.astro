---
/**
 * Nav.astro  —  src/components/Nav.astro
 * ============================================================
 * Top navigation: Work/About pills on the right, plus an optional
 * "< Back" pill on the left on case-study sub-pages. Aligns to the same page margins as all
 * other content.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Nav layout"   → how the bar is positioned and spaced
 *   "Nav links"    → the shared .nav-link pill style (Work, About, Back)
 *   "Hover"        → mouse-over state
 * ============================================================
 *
 * To restyle every nav pill at once: edit .nav-link below
 * To change pill colors: edit --color-nav-bg and --color-nav-border in tokens.css
 */

interface Props {
  activePage: "work" | "about";
  /** Set on case-study sub-pages to render a "< [Project]" pill
   *  at the top-left, opposite the Work/About group. */
  backHref?: string;
  backLabel?: string;
}

const { activePage, backHref, backLabel } = Astro.props;
---

<nav>

  <div class="nav-row">
    <!-- Back pill — top-left, only on case-study sub-pages -->
    {backHref && (
      <a href={backHref} class="nav-link nav-back">
        <span>&lt; {backLabel}</span>
        {/* < symbol = &lt; */}
      </a>
    )}

    <!-- Work / About pills -->
    <div class="nav-links">
      <a href="/" class="nav-link">
        <span>Work</span>
      </a>
      <button data-modal="about" class="nav-link">
        <span>About</span>
      </button>
    </div>
  </div>

</nav>

<style>
  /* =============================================
     Nav layout
     Fixed bar across the top: optional Back pill on the
     left, Work/About group on the right.
     Padding matches --grid-inset so pills align to the
     same image edges as the gallery / project grid.
  ============================================= */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    box-sizing: border-box;

    /* Side padding = --grid-inset (tokens.css), the same inset as the image
       edges, so the PILL BOX (visible via its backdrop blur) lines up with
       the right edge of the last image/media column. */
    padding: var(--space-3) var(--grid-inset);
    pointer-events: none; /* bar itself doesn't capture clicks */
  }

  /* Single row — Back pill (if any) on the left, Work/About on the right. */
  .nav-row {
    display: flex;
    align-items: center;
    gap: var(--grid-gutter);
    width: 100%;
  }

  /* Pushes Work/About to the right edge whether or not the Back pill exists. */
  .nav-links {
    margin-left: auto;
  }

  /* Long project names shouldn't push Work/About off-screen on mobile. */
  .nav-back {
    min-width: 0;
  }
  .nav-back span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* =============================================
     Nav links
     .nav-link is the one shared pill style for every
     nav button: Work, About, and the Back pill.
  ============================================= */
  /* Gap matches the visible gutter between card images (--grid-gutter). */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--grid-gutter);
  }

  .nav-link {
    appearance: none;
    background: none;
    cursor: pointer;
    pointer-events: all;   /* re-enable clicks — nav itself has pointer-events:none */
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    /* border-radius: var(--radius-pill); */
    border-radius: 4px;
    text-decoration: none;
    border: none;   /* <button> ships with a default outset border; <a> doesn't */

    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background-color: transparent;
    backdrop-filter: blur(12px);          
    -webkit-backdrop-filter: blur(12px); 

    transition: background-color var(--duration-fast) ease;
  }

  /* Narrow phones — slimmer pills so the Back label fits beside Work/About. */
  @media (max-width: 480px) {
    .nav-link {
      padding-inline: var(--space-2);
    }
  }

  /* =============================================
     Hover
  ============================================= */
  .nav-link:hover {
    background-color: var(--color-surface-raised);
    text-decoration: none;
  }
</style>
