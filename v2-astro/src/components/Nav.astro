---
/**
 * Nav.astro  —  src/components/Nav.astro
 * ============================================================
 * EVERYTHING nav lives in this file: the bar, the "Back to:" link,
 * Work / About, the About modal it opens, and the nav's page-transition
 * layer. Both layouts just render <Nav />. No props.
 *
 *   | Back to: BSP Home Page                         Work   About |
 *     ^ first image edge (--grid-inset)         last image edge ^
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "Back link"   → how the parent page + its name are found
 *   "Nav tokens"  → --nav-height (the one value other files read)
 *   "Nav layout"  → bar position, background and spacing
 *   "Nav links"   → the one shared link style (Back, Work, About, ✕)
 *   "About modal" → the overlay About opens
 * ============================================================
 *
 * BACK LINK — no per-page wiring.
 *   The parent is the URL one level up, skipping levels with no page
 *   ("/work" isn't a page, so /work/marvel → /):
 *     /work/best-summer-programs/competitionsv2 → /work/best-summer-programs
 *     /work/best-summer-programs                → /
 *     /                                         → (no back link)
 *   The NAME comes from the parent page itself. Each page that can be a
 *   parent declares, in its own frontmatter:
 *       export const navTitle = "BSP Home Page";
 *   That one line is the only place a page's nav name is written.
 *   A page without it falls back to its URL ("best-summer-programs" →
 *   "Best Summer Programs").
 */

import AboutModal from "./AboutModal.astro";

/* =============================================
   Back link
============================================= */
type PageModule = { navTitle?: string };
const pages = import.meta.glob<PageModule>("/src/pages/**/*.astro");

// "/src/pages/work/bsp/index.astro" → "/work/bsp"
const routeOf = (file: string) =>
  file.replace(/^\/src\/pages/, "").replace(/\.astro$/, "").replace(/\/index$/, "") || "/";
const routes = new Map(Object.entries(pages).map(([file, load]) => [routeOf(file), load]));

const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";

let back: { href: string; name: string } | undefined;
if (here !== "/") {
  let href = here;
  do {
    href = href.slice(0, href.lastIndexOf("/")) || "/";
  } while (!routes.has(href)); // "/" always exists, so this ends

  const mod = await routes.get(href)!();
  const fallback = (href.split("/").pop() || "home")
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
  back = { href, name: mod.navTitle ?? fallback };
}
---

<nav class="site-nav" aria-label="Site">
  {back && (
    <a href={back.href} class="nav-link nav-back">
      <span class="nav-back-text">Back to: {back.name}</span>
    </a>
  )}

  <div class="nav-links">
    <a href="/" class="nav-link" aria-current={here === "/" ? "page" : undefined}>Work</a>
    <button type="button" class="nav-link" data-about-open>About</button>
  </div>
</nav>

<!-- About modal -->
<div id="about-modal" class="modal-backdrop" aria-hidden="true">
  <div class="modal-panel" role="dialog" aria-modal="true" aria-label="About Aarnav">
    <div class="modal-header">
      <button type="button" class="nav-link modal-close" aria-label="Close">✕</button>
    </div>
    <div class="modal-body">
      <AboutModal />
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("about-modal")!;
  const panel = modal.querySelector(".modal-panel")!;

  function setOpen(open: boolean) {
    modal.classList.toggle("is-open", open);
    modal.setAttribute("aria-hidden", String(!open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  document.querySelector("[data-about-open]")?.addEventListener("click", () => setOpen(true));
  modal.querySelector(".modal-close")!.addEventListener("click", () => setOpen(false));
  modal.addEventListener("click", (e) => {
    if (!panel.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style is:global>
  /* =============================================
     Nav tokens
     The nav is an IN-FLOW STICKY HEADER: it takes up its own
     space at the top of the page (so every page starts below
     it automatically) and sticks to the top while scrolling.
     No page adds padding to "clear" it.

     --nav-height is the bar's height, and the only nav value
     read elsewhere: things that stick or scroll under the bar
     (ProjectTOC, anchor links, layout min-heights). Change it
     here and all of them follow.
  ============================================= */
  :root {
    --nav-height: 3rem; /* 48px */
  }

  /* Anchor links (#section) land below the bar, not under it. */
  html {
    scroll-padding-top: var(--nav-height);
  }

  /* Page transitions (PageTransitions.astro): the nav is its own
     layer so it stays put on top while the page sheets slide.
     No crossfade: the new nav (and its Back link) swaps in instantly. */
  .site-nav {
    view-transition-name: site-nav;
  }
  ::view-transition-group(site-nav) {
    z-index: 100;
  }
  ::view-transition-old(site-nav) {
    display: none;
  }
  ::view-transition-new(site-nav) {
    animation: none;
  }
</style>

<style>
  /* =============================================
     Nav layout
     Full-width bar, same on every page. Sticky (see
     "Nav tokens"). Side padding = --grid-inset, so the
     Back link starts on the first image edge and About
     ends on the last one (homepage + project grid).
     Background: the page color, slightly see-through and
     blurred, so content scrolling under it stays quiet.
  ============================================= */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: var(--grid-gutter);
    padding-inline: var(--grid-inset);
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-links {
    display: flex;
    gap: var(--grid-gutter);
    margin-left: auto; /* right edge, with or without a Back link */
  }

  /* =============================================
     Nav links
     One style for every nav control: Back, Work,
     About, and the modal's ✕.
  ============================================= */
  .nav-link {
    appearance: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background-color: transparent;

    font: inherit;
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;

    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text-primary);
  }
  .nav-link:hover {
    background-color: var(--color-surface);
  }

  /* Back: same look as Work/About. Long names truncate instead
     of pushing Work/About off a phone. */
  .nav-back {
    min-width: 0;
  }
  .nav-back-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 480px) {
    .nav-link {
      padding-inline: var(--space-2);
    }
  }

  /* =============================================
     About modal
     Centered panel on desktop, bottom sheet on phones.
  ============================================= */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);

    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) ease;
  }
  .modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Flex column: header stays put, body scrolls. */
  .modal-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 750px;
    max-height: 80svh;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);

    transform: translateY(12px);
    transition: transform var(--duration-normal) ease;
  }
  .modal-backdrop.is-open .modal-panel {
    transform: none;
  }

  .modal-header {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    padding: var(--space-4) var(--space-4) 0;
  }

  .modal-body {
    flex: 1;
    min-height: 0; /* lets the flex child scroll */
    overflow-y: auto;
    padding: var(--space-6) var(--space-10) var(--space-10);
  }

  @media (max-width: 640px) {
    .modal-backdrop {
      align-items: flex-end;
      padding: 0;
    }
    .modal-panel {
      max-height: 75svh;
      border-bottom: none;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      transform: translateY(100%);
    }
    .modal-body {
      padding: var(--space-4) var(--space-6) var(--space-8);
    }
  }
</style>
