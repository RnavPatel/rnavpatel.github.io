---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs — Compare and Bookmarks"
  backHref="/work/best-summer-programs"
  backLabel="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "design-goal", label: "Design Goal" },
    {id: "solution", label: "Solution"},
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header" slot="header">
    
    <p class="text-heading">
      <span class="tint-bsp">
        <span class="text-sup">Case Study</span> 
      </span>
      Always engaging students throughout the product with a <strong>playful illustration system</strong>.
    </p>

  </header>

  <!-- HERO (full width) ----------------------------------->
  <img slot="hero" src="/images/BestSummerPrograms/Illustration/BSP_UI_Illustrations_Hero_v2.png" alt="BSP Placeholder">

  <!-- Problem -->
  <section id="problem">
    <p class="text-heading">
      <span class="tint-gray">
        <span class="text-sup">Context</span>
      </span>
      Our product uses simple visuals to make our info-dense database clear, 
      <span class="tint-problem"><span class="text-sup">Problem</span>
      however, this sometimes leaves users to <strong>face empty screens</strong> with no guidance.</span>
    </p>

    <div class="p-media-2col">
      <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Illustration/Illustration_Problem1.png" alt="old">
      </div>
            <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Illustration/Illustration_Problem2.png" alt="old">
      </div>
    </div>

  </section>

  <!-- Design Goal -->
  <section id="design-goal">
    <div class="p-detail">
      <p class="text-heading">
        <span class="text-sup">Insight</span> 
        Blank screens are read as broken screens,
        <span class="tint-goal"><span class="text-sup">Design Goal</span>
        so we needed some way to make our users <strong>always feel welcomed.</strong></span>
      </p>
    </div>
  </section>

  <section id="solution">
    <div class="p-detail">
      <p class="text-heading">
        <span class="tint-goal">
          <span class="text-sup">Solution</span>
          A playful illustration system</span> to transform dead-end moments into delightful experiences. 
      
      </p>
      <p>Reimagining classic summer scenes as school - project diaromas.</p>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Illustration/UI_Illustrations.mp4" type="video/mp4" />
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Illustration/IllustrationsInContext_Prototype.mov" type="video/mp4" />
    </div>


  <div class="p-media">
    <img src="/images/BestSummerPrograms/BSP_UI_Illustrations_Hero.png" alt="UI Diagram">
  </div>
  
  <div class="p-media">
    <img src="/images/BestSummerPrograms/UI_Concept.png" alt="UI Diagram">
  </div>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/Banner_Designs.png" alt="UI Diagram">
  </div>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/Illustration_Style_Guide.png" alt="UI Diagram">
  </div>

  <p class="text-heading">
    More to come...
  </p>
  </section>


</ProjectLayout>
