---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs — Compare and Bookmarks"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "design-goal", label: "Design Goal" },
    {id: "solution", label: "Solution"},
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header" slot="header">
    
    <div class="p-beat">
      <p class="p-beat-eyebrow tint-bsp">BestSummerPrograms</p>
      <h2 class="p-beat-heading">Always engaging students throughout the product with a <span class="tint-bsp">playful illustration system</span>.</h2>
    </div>

  </header>

  <!-- HERO (full width) ----------------------------------->
  <img slot="hero" src="/images/BestSummerPrograms/Illustration/BSP_UI_Illustrations_Hero_v2.png" alt="BSP Placeholder">

  <!-- Problem -->
  <section id="problem">
    <div class="p-beat">
      <p class="p-beat-eyebrow">Context</p>
      <h2 class="p-beat-heading">Our product uses simple visuals to make our info-dense database clear, <span class="tint-problem">however, this sometimes leaves users to <strong>face empty screens</strong> with no guidance.</span></h2>
    </div>

    <div class="p-media-2col p-no-outline">
      <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Illustration/Illustration_Problem1.png" alt="old">
      </div>
            <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Illustration/Illustration_Problem2.png" alt="old">
      </div>
    </div>

  </section>

  <!-- Design Goal -->
  <section id="design-goal">
    <div class="p-beat">
      <p class="p-beat-eyebrow">Insights</p>
      <h2 class="p-beat-heading">Blank screens are read as broken screens, <span class="tint-goal">so we needed some way to make our users <strong>always feel welcomed.</strong></span></h2>
    </div>
  </section>

  <section id="solution">
    <div class="p-beat">
      <p class="p-beat-eyebrow tint-goal">Solution</p>
      <h2 class="p-beat-heading"><span class="tint-goal">A playful illustration system</span> to transform dead-end moments into delightful experiences.</h2>
      <div class="p-beat-body">
        <p>Reimagining classic summer scenes as school - project diaromas.</p>
      </div>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Illustration/UI_Illustrations.mp4" type="video/mp4" />
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Illustration/IllustrationsInContext_Prototype.mov" type="video/mp4" />
    </div>


  <div class="p-media">
    <img src="/images/BestSummerPrograms/BSP_UI_Illustrations_Hero.png" alt="UI Diagram">
  </div>
  
  <div class="p-media">
    <img src="/images/BestSummerPrograms/UI_Concept.png" alt="UI Diagram">
  </div>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/Banner_Designs.png" alt="UI Diagram">
  </div>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/Illustration_Style_Guide.png" alt="UI Diagram">
  </div>

  <div class="p-beat">
    <h2 class="p-beat-heading">More to come...</h2>
  </div>
  </section>


</ProjectLayout>
