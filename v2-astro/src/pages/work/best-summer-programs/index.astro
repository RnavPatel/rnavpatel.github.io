---
/**
 * index.astro — src/pages/work/best-summer-programs/index.astro
 *
 * This is the project HUB page: overview + a grid of ProjectCard
 * tiles (size="col2"), each linking out to its own dedicated
 * case-study sub-page in this same folder (navigation-redesign.astro,
 * competitions.astro, compare-bookmarks.astro).
 *
 * TO ADD ANOTHER CASE STUDY:
 *   1. Copy one of the sibling .astro files in this folder
 *   2. Add a matching <ProjectCard size="col2"> below in the ".p-card-grid"
 */

import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
---

<ProjectLayout
  title="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "case-studies", label: "Case Studies" },
  ]}
>

  <!-- META (row under the title) ------------------------------>
  <div slot="meta">
    <div class="p-meta-grid">
    <div>
      <p class="label">Role</p>
      <h4>
        Sole Product Designer <br>
      </h4>
    </div>

    <div>
      <p class="label">Skills</p>
      <h4>
        Product Design<br>
        UIUX Design <br>
        Product Strategy <br>
        Front-end Development
      </h4>
    </div>
    <div>
        <p class="label">Team</p>

        <a href="https://www.ethanhuangdesign.com/" target="_blank">Ethan Huang</a> <br />
        Saul Lelchuk <br/>
          Maisea Bailey <br/>

      </div>
    </div>
  </div>

  <!-- HEADER ------------------------------------------------->
<header id="overview" class="p-header" slot="header">

  <p class="text-heading">
    <span style="color: black"><strong>BestSummerPrograms </strong></span>
      <span class="tint-bsp">
        <span class="text-sup">Overview</span> 
      </span>
      is an accessible database for families and counselors to navigate the precollege landscape.
  </p>

</header>

<!-- HERO (full width) ----------------------------------->
<img slot="hero" src="/images/Placeholders/BSP_Hero_V3.png" alt="Best Summer Programs Hero Image" />

<!-- CONTEXT -->
<section id="context">
  <p class="text-heading">
    <span class="tint-context">
      <span class="text-sup">Context</span>
      The platform was growing
    </span> 
    its summer program database and expanding into high school competitions as a new vertical.
    <br>
    <span class="tint-scope">
      <span class="text-sup">Scope</span>
      I owned the scale-up initiative:</span>
    updating existing visual systems, and building new features to support a larger database and user base across devices.
  </p>
</section>

<!-- CASE STUDIES -->
<section id="case-studies">
  <hr class="p-divider" />
  <div class="heading">
    <p class="text-heading">
    <span class="tint-bsp">
      <span class="text-sup">Case Studies</span>
    </span> 

      <strong>Explore the redesign.</strong>
    </p>
  </div>

  <div class="p-card-grid">
    <ProjectCard
      title="Navigation Redesign"
      subtitle="Database Browsing System"
      tags={[]}
      href="/work/best-summer-programs/navigation-redesign"
      image="/images/BestSummerPrograms/Nav_CaseStudy_Hero.png"
      mediaType="image"
      size="square"
      status="shipped"
    />
    <ProjectCard
      title="Competitions Pages"
      subtitle="Presenting Variable Data"
      tags={[]}
      href="/work/best-summer-programs/competitionsv2"
      image="/images/BestSummerPrograms/CompetitionsPageHero.png"
      mediaType="image"
      size="wide"
      status="shipped"
    />
    <ProjectCard
      title="Compare and Bookmarks"
      subtitle="User-Item Collections"
      tags={[]}
      href=""
      image="/images/BestSummerPrograms/BookmarksCompareHero.png"
      mediaType="image"
      size="col2"
      locked
      status="in-construction"
    />

    <ProjectCard
      title="UI Illustrations"
      subtitle="Extended Visual System"
      tags={[]}
      href="/work/best-summer-programs/ui-illustrations"
      image="/images/BestSummerPrograms/Illustration/BSP_UI_Illustrations_Hero_v2.png"
      mediaType="image"
      size="col2"
      status="shipped"
    />

    <ProjectCard
      title="Landing Page Redesign"
      subtitle="Extended Visual System"
      tags={[]}
      href=""
      image="/images/BestSummerPrograms/LandingPage_Hero.png"
      mediaType="image"
      size="col2"
      status="shipped"
      locked
    />
  </div>
</section>

</ProjectLayout>
