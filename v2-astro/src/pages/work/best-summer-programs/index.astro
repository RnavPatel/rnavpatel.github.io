---
/**
 * index.astro — src/pages/work/best-summer-programs/index.astro
 *
 * This is the project HUB page: overview + a <CardGallery> of
 * ProjectCard tiles (same gallery as the homepage — set
 * size="square" or size="wide" per card), each linking out to its own dedicated
 * case-study sub-page in this same folder (navigation-redesign.astro,
 * competitions.astro, compare-bookmarks.astro).
 *
 * TO ADD ANOTHER CASE STUDY:
 *   1. Copy one of the sibling .astro files in this folder
 *   2. Add a matching <ProjectCard size="square"|"wide"> inside <CardGallery> below
 */

import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import CardGallery from "../../../components/CardGallery.astro";
---

<ProjectLayout
  title="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "case-studies", label: "Case Studies" },
  ]}
>

  <!-- META (row under the title) ------------------------------>
  <div slot="meta">
    <div class="p-meta-grid">
    <div>
      <p class="label">Role</p>
      <h4>
        Sole Product Designer <br>
      </h4>
    </div>

    <div>
      <p class="label">Skills</p>
      <h4>
        Product Design<br>
        UIUX Design <br>
        Product Strategy <br>
        Front-end Development
      </h4>
    </div>
    <div>
        <p class="label">Team</p>

        <a href="https://www.ethanhuangdesign.com/" target="_blank">Ethan Huang</a> <br />
        Saul Lelchuk <br/>
          Maisea Bailey <br/>

      </div>
    </div>
  </div>

  <!-- HEADER ------------------------------------------------->
<header id="overview" class="p-header" slot="header">
  <div class="p-beat">
      <h2 class="p-beat-heading"><span class="tint-bsp"><strong>BestSummerPrograms</strong> is an open source database</span> for families and counselors to navigate the precollege landscape.
      </h2>
    </div>

</header>


<!-- CASE STUDIES -->
<section id="case-studies">
  <!-- <hr class="p-divider" /> -->
  <div class="heading">
    <p class="text-heading">

      <strong>Explore the redesign.</strong>
    </p>
  </div>

  <CardGallery>
    <ProjectCard
      title="Navigation Redesign"
      subtitle="Database Browsing System"
      tags={[]}
      href="/work/best-summer-programs/navigation-redesign"
      image="/images/BestSummerPrograms/Nav/NavCaseStudy_hero_Placeholder_v2.png"
      mediaType="image"
      size="square"
      status="shipped"
    />
    <ProjectCard
      title="Competitions Pages"
      subtitle="Presenting Variable Data"
      tags={[]}
      href="/work/best-summer-programs/competitionsv2"
      image="/images/BestSummerPrograms/Competitions/CompetitionsCaseStudy_hero_Placeholder_v2.png"
      mediaType="image"
      size="square"
      status="shipped"
    />
    <ProjectCard
      title="UI Illustrations"
      subtitle="Extended Visual System"
      tags={[]}
      href="/work/best-summer-programs/ui-illustrations"
      image="/images/BestSummerPrograms/Illustration/IllustrationCaseStudy_hero_Placeholder.png"
      mediaType="image"
      size="square"
      status="shipped"
    />

    <!-- <ProjectCard
      title="Compare and Bookmarks"
      subtitle="User-Item Collections"
      tags={[]}
      href=""
      image="/images/BestSummerPrograms/BookmarksCompareHero.png"
      mediaType="image"
      size="square"
      locked
      status="in-construction"
    />

    <ProjectCard
      title="Landing Page Redesign"
      subtitle="Extended Visual System"
      tags={[]}
      href=""
      image="/images/BestSummerPrograms/LandingPage_Hero.png"
      mediaType="image"
      size="square"
      status="shipped"
      locked
    /> -->
  </CardGallery>
</section>

</ProjectLayout>
