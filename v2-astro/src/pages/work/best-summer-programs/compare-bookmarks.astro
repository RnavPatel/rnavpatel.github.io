---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs — Compare and Bookmarks"
  backHref="/work/best-summer-programs"
  backLabel="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "design-goal", label: "Design Goal" },
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header">
    <p class="label">Case Study 3</p>
    <h1>Compare and Bookmarks</h1>
  </header>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/BookmarksCompareHero.png" alt="BSP Placeholder">
  </div>

  <!-- Problem -->
  <section id="problem">
    <div class="p-detail">
      <p class="label">Problem</p>
      <h3>Repeating UX features across multiple databases
      </h3>
      <p>
        With the new competitions vertical, existing flows for saving and comparing programs weren't built to handle two content types in parallel.
      </p>
    </div>

    <div class="p-media" style="margin-bottom: var(--space-1)">
      <img src="/images/BestSummerPrograms/CompareBookmark_Old1.png" alt="old">
    </div>
    <div class="p-media" style="margin-bottom: var(--space-1)">
      <img src="/images/BestSummerPrograms/CompareBookmark_Old2.png" alt="old">
    </div>
    <div class="p-media">
      <img src="/images/BestSummerPrograms/CompareBookmark_Old3.png" alt="old">
    </div>
  </section>

  <!-- Design Goal -->
  <section id="design-goal">
    <div class="p-detail">
      <p class="label">Design Goal</p>
      <h3>Consolidate user-item interactions into one UX flow
      </h3>
      <p>
        Tabs within a single Bookmarks page and Compare modal keep the two datasets distinct without requiring separate entry points, navigation states, or duplicate feature logic.
      </p>
    </div>
  </section>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/Bookmarks_UI_Diagram.png" alt="UI Diagram">
  </div>

  <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Bookmarks_Scroll.mov" type="video/mp4" />
      </video>  
  </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Bookmarks_Toggle.mov" type="video/mp4" />
      </video>  
  </div>

</ProjectLayout>
