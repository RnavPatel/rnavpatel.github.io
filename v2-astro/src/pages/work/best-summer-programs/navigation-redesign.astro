---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs — Navigation Redesign"
  backHref="/work/best-summer-programs"
  backLabel="Overview"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "design-goal", label: "Design Goal" },
    {id: "solution", label: "Solution"},
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header" slot="header">
    <div class="p-beat">
      <p class="p-beat-eyebrow tint-bsp">BestSummerPrograms</p>
      <h2 class="p-beat-heading">Allowing families and counselors to <span class="tint-bsp">filter and navigate</span> across our growing databases.
      </h2>
    </div>
  </header>

    <div slot="meta">
    <div class="p-meta-grid">
    <div>
      <p class="label">Role</p>
      <h4>
        Sole Product Designer <br>
      </h4>
    </div>

    <div>
      <p class="label">Skills</p>
      <h4>
        Product Design<br>
        UIUX Design <br>
        Front-end Development
      </h4>
    </div>
    <div>
        <p class="label">Team</p>

        <a href="https://www.ethanhuangdesign.com/" target="_blank">Ethan Huang</a> <br />
        Saul Lelchuk <br/>
          Maisea Bailey <br/>

      </div>
    </div>
  </div>

  <!-- HERO (full width) ----------------------------------->
  <!-- <img slot="hero" src="/images/BestSummerPrograms/Nav_CaseStudy_Hero.png" alt="BSP Placeholder"> -->
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/NavRedesign_Hero.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Desktop navigation usage (search hover, subject pick, category pick, more filters)</strong></p>
    </div>

    <div class="p-media">
      <img src="/images/BestSummerPrograms/Nav/Nav_Mobile_ScreensOverview.png" alt="Diagram">
    </div>


  <!-- Problem -->
  <section id="context">
    <div class="p-beat">
      <p class="p-beat-eyebrow">Context</p>
      <h2 class="p-beat-heading">Shifting from high school programs to all precollege opportunities.</h2>
      <div class="p-beat-body">
        <p>Our database grew from 50 to 500+ programs, a new 175+ competitions database, and plans to add more verticals like middle school programs.</p>
      </div>
    </div>

    <div class="p-media p-narrow">
      <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Nav/Nav_BeforeCallout.png" alt="Previous Design">
      </div>
      <p class="caption">Previous MVP was built just for 50 programs</p>
  </section> 
  
  <section id="problem">
    <div class="p-beat">
      <p class="p-beat-eyebrow tint-problem">Problem</p>
      <h2 class="p-beat-heading">The database content outgrew its design, <span class="tint-problem">isolating users from new content. </span></h2>
      <div class="p-beat-body">
        <p>Our content aimed to holistically consolidate pre-college opportunities across disciplines, but our current product was signalling solely around programs to our users. </p>
      </div>
    </div>
      <div class="p-no-outline">
        <img src="/images/BestSummerPrograms/Nav/Before_Diagram.png" alt="Refined Design">
      </div>
    </div>

  </section>

  <section id="solution">
    <div class="p-beat">
      <p class="p-beat-eyebrow tint-goal">Solution</p>
      <h2 class="p-beat-heading">A <span class="tint-goal">broader navigation</span> system and <span class="tint-goal">specialized filtering</span> experience.</h2>
      <div class="p-beat-body">
        <p>Surfacing a site-wide search bar for direct navigation across databases, and adapting our filtering system based on user-priorities per database.
        </p>
      </div>
    </div>

      <div class="p-media p-narrow">
        <div class="p-no-outline">
          <img src="/images/BestSummerPrograms/Nav/Goal_Diagram.png" alt="Refined Design">
        </div>
      </div>
    </div>

    

  <section id="design-intent">

    <div class="p-beat">
      <p class="p-beat-eyebrow tint-bsp">Design Intent</p>
      <h2 class="p-beat-heading">To keep users aware of the growing databases.</h2>
      <div class="p-beat-body">
        <p>Our information structure needs to connect our growing databases and make them feel accessible to our users.
        </p>
      </div>
    </div>
  </section>


    <div class="p-media-2col">
      <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Nav/Nav_OverallBefore2.png" alt="Previous Design">
        <p class="caption">Before</p>
      </div>
      <div>
      <img src="/images/BestSummerPrograms/Nav/Nav_OverallAfter2.png" alt="Refined Design">
      <p class="caption">After</p>
      </div>
    </div>

    <div class="p-media-2col">
      <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Nav/Mobile_OverallBefore.png" alt="Previous Design">
        <p class="caption">Before</p>
      </div>
      <div>
      <img src="/images/BestSummerPrograms/Nav/Mobile_OverallAfter.png" alt="Refined Design">
      <p class="caption">After</p>
      </div>
    </div>



  <!-- UI Layout -->


  <section id="ui-layout">

    <div class="p-media">
      <img src="/images/BestSummerPrograms/Navigation_UI_Diagram.png" alt="Diagram">
      <p class="caption"><strong>Desktop navigation usage (search hover, subject pick, category pick, more filters)</strong></p>
    </div>

  </section>

  <!-- Filter Modal -->
  <section id="filter-modal">


    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Filters.mov" type="video/mp4" />
      </video>
    </div>
  </section>

  <!-- Mobile -->
  <section id="mobile">
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/NavRedesign_Mobile.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Mobile navigation usage (Menu expand, subject pick, category pick, more filters)</strong></p>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Mobile_Filter.mov" type="video/mp4" />
      </video>
    </div>

      <p class="text-heading">
    More to come...
  </p>
  </section>

</ProjectLayout>
