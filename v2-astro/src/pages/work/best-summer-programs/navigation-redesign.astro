---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs — Navigation Redesign"
  backHref="/work/best-summer-programs"
  backLabel="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "design-goal", label: "Design Goal" },
    {id: "solution", label: "Solution"},
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header" slot="header">
    <p class="text-heading">
      <span class="tint-bsp">
        <span class="text-sup">Case Study</span>
      </span>
      Allowing families and counselors to <strong>filter and navigate</strong> across our growing databases.
    </p>
  </header>

  <!-- HERO (full width) ----------------------------------->
  <img slot="hero" src="/images/BestSummerPrograms/Nav_CaseStudy_Hero.png" alt="BSP Placeholder">

  <!-- Problem -->
  <section id="problem">
    <p class="text-heading">
      <span class="tint-gray">
        <span class="text-sup">Context</span>
      </span>
        Our database grew from 50 to 500+ programs, and added a new 175+ competitions database to the platform,
      <span class="tint-problem">
        <span class="text-sup">Problem</span>
        however, our users weren't aware of how to access the new content.
      </span>
    </p>

    <div class="p-media">
      <div class="p-not-mine">
        <img src="/images/BestSummerPrograms/Old.png" alt="Previous Design">
      </div>
      
      <p class="caption">Previous MVP was built just for 50 programs</p>
    </div>
  </section>

  <!-- Design Goal -->
  <section id="design-goal">

    <div class="p-detail">
      <p class="text-heading">
      <span class="tint-gray">
        <span class="text-sup">Insight</span>
      </span>
          Our users were unaware of the new content and features,
        <span class="tint-goal">
          <span class="text-sup">Design Goal</span>
          so we needed to create a more intuitive navigation experience.
        </span>
      </p>
    </div>

    <p class="text-heading">
        <span class="tint-goal">
          <span class="text-sup">Solution</span>
           A redesigned filtering and navigation system.
        </span>
      </p>

          <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/NavRedesign_Hero.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Desktop navigation usage (search hover, subject pick, category pick, more filters)</strong></p>
    </div>
  </section>

  <!-- UI Layout -->


  <section id="ui-layout">

    <div class="p-media">
      <img src="/images/BestSummerPrograms/Navigation_UI_Diagram.png" alt="Diagram">
      <p class="caption"><strong>Desktop navigation usage (search hover, subject pick, category pick, more filters)</strong></p>
    </div>
  </section>

  <!-- Filter Modal -->
  <section id="filter-modal">


    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Filters.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Mobile navigation usage (Menu expand, subject pick, category pick, more filters)</strong></p>
    </div>
  </section>

  <!-- Mobile -->
  <section id="mobile">

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/NavRedesign_Mobile.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Mobile navigation usage (Menu expand, subject pick, category pick, more filters)</strong></p>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Mobile_Filter.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Filter modal</strong></p>
    </div>

      <p class="text-heading">
    More to come...
  </p>
  </section>

</ProjectLayout>
