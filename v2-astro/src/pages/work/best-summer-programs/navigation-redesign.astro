---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs — Navigation Redesign"
  backHref="/work/best-summer-programs"
  backLabel="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    { id: "problem", label: "Problem" },
    { id: "design-goal", label: "Design Goal" },
    { id: "ui-layout", label: "UI Layout" },
    { id: "filter-modal", label: "Filter Modal" },
    { id: "mobile", label: "Mobile" },
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header">
    <p class="label">Case Study 1</p>
    <h1>Navigation Redesign</h1>

    <p>
      A navigation experience rebuilt to stay clear and explorable as BSP's databases grow.
    </p>
  </header>

  <div class="p-media">
    <img src="/images/BestSummerPrograms/Nav_CaseStudy_Hero.png" alt="BSP Placeholder">
  </div>

  <!-- Problem -->
  <section id="problem">
    <div class="p-detail">
      <p class="label">Problem</p>
      <h3>Users couldn’t easily access all of the databases
      </h3>
      <p>
        Previous UX flows were only designed for the single program database, and
        less metadata attributed to each entry, limiting access to all corners of the site.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/BestSummerPrograms/Old.png" alt="Previous Design">
      <p class="caption">Previous Design built just for programs (Not my work)</p>
    </div>
  </section>

  <!-- Design Goal -->
  <section id="design-goal">
    <div class="p-detail">
      <p class="label">Design Goal</p>
      <h3>Bring visibility to new data
      </h3>
      <p>
        Create more entry points throughout the site to explore and learn
        seamlessly between programs, competitions, and their respective pages.
      </p>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/NavRedesign_Hero.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Desktop navigation usage (search hover, subject pick, category pick, more filters)</strong></p>
    </div>
  </section>

  <!-- UI Layout -->
  <section id="ui-layout">
    <div class="p-detail">
      <p class="label">UI Layout</p>
      <h3>Restructured navigation hierarchy: search, tabs, filters
      </h3>
      <p>
        The layout aims to keep users aware of their selections
        and location throughout the browse experience.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/BestSummerPrograms/Navigation_UI_Diagram.png" alt="Diagram">
      <p class="caption"><strong>Desktop navigation usage (search hover, subject pick, category pick, more filters)</strong></p>
    </div>
  </section>

  <!-- Filter Modal -->
  <section id="filter-modal">
    <div class="p-detail">
      <p class="label">Filter Modal</p>
      <h3>Icon driven filters to for quick readability
      </h3>
      <p>
        Introduce icon association with metadata filters that will be used frequently
        throughout project and competition pages.
      </p>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Filters.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Mobile navigation usage (Menu expand, subject pick, category pick, more filters)</strong></p>
    </div>
  </section>

  <!-- Mobile -->
  <section id="mobile">
    <div class="p-detail">
      <p class="label">Mobile Compatability</p>
      <h3>Condense navigation for familiar mobile interactions
      </h3>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/NavRedesign_Mobile.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Mobile navigation usage (Menu expand, subject pick, category pick, more filters)</strong></p>
    </div>

    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/BestSummerPrograms/Mobile_Filter.mov" type="video/mp4" />
      </video>
      <p class="caption"><strong>Filter modal</strong></p>
    </div>
  </section>

</ProjectLayout>
