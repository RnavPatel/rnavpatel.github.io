---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Best Summer Programs"
  tocItems={[
    { id: "overview", label: "Overview" },
    {id: "section1", label: "Navigation Design"},
    {id: "section2", label:"Competitions Page"},
  ]}
>

  <!-- HEADER ------------------------------------------------->
<!-- HEADER ------------------------------------------------->
<header id="overview" class="p-header">
  <h1>BestSummerPrograms</h1>

  <p>
    An accessible database for high school students to navigate the precollege landscape. <strong>Product is still ongoing</strong>
  </p>

  <hr class="p-divider"></hr>

  <div class="p-meta-grid" style="margin-top: var(--space-10)">
    <div>
      <p class="label">Role</p>
      <h4>
        Product Designer <br>
      </h4>
    </div>

    <div>
      <p class="label">Skills</p>
      <h4>
        Product Designer <br>
        Lead UIUX Designer <br>
      </h4>
    </div>
    <div>
      <p class="label">Duration</p>
      <h4>
        March 2026 - Present
      </h4>
    </div>
    <div>
        <p class="label">Team</p>

        <a href="https://www.ethanhuangdesign.com/" target="_blank">Ethan Huang</a> <br />
        Saul Lelchuk <br/>
          Maisea Bailey <br/>

      </div>
    </div>
  </div>
  <div class="p-media">
    <img src="/images/Placeholders/BSP_Placeholder2.png">
  </div>


  <div class="p-section-open">
    <p class="label">Context</p>
    <h3><span style="background-color: #ffdb5baa">The platform was growing</span> its summer program database and expanding into high school competitions as a new vertical.
    </h3>
  </div>

  <div class="p-section-open">
    <p class="label">Overview</p>
    <h3><span style="background-color: #5BFFA5AA">I owned the scale-up initiative:</span> redesigning the visual systems, and UX flows to support a larger database and user base across devices.
    </h3>
  </div>



