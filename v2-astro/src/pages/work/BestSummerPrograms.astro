    <div class="p-media-2col">
      <div>
        <img src="/images/Placeholders/BSP_Placeholder2.png" alt="BSP Placeholder">
        <p class="caption"><strong>1. Navigation Redesign</strong></p>
      </div>
      
      <div>
        <img src="/images/Placeholders/BSP_Placeholder2.png" alt="BSP Placeholder">
