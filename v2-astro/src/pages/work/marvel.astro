---
/**
 * marvel.astro — src/pages/work/marvel.astro
 *
 * IMAGE PATHS: all media references /images/Marvel/...
 * These need to live at v2-astro/public/images/Marvel/
 *
 * TOC MARKERS (for future TOC — keep ids in sync):
 *   #overview    → project header
 *   #problem     → Problem section
 *   #opportunity → Opportunity section
 *   #concept     → Concept section
 *   #game-design → Game Design section
 *   #features    → Features section
 *   #process     → Process section
 */

import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Fracture: A Marvel Pop-Up Experience"
  tocItems={[
    { id: "overview",    label: "Overview" },
    { id: "problem",     label: "Problem" },
    { id: "opportunity", label: "Opportunity" },
    { id: "concept",     label: "Concept" },
    { id: "game-design", label: "Game Design" },
    { id: "features",    label: "Features" },
    { id: "process",     label: "Process" },
  ]}
>

  <!-- HEADER ------------------------------------------------->
  <header id="overview" class="p-header">
    <h1>Fracture:<br />A Marvel Pop-Up Experience</h1>

    <p>
      An immersive phygital game prototype for MCU fans.
    </p>

    <hr class="p-divider" style="margin-top: var(--space-4)" />

    <div class="p-meta-grid" style="margin-top: var(--space-10)">
      <div>
        <p class="label">Role & Scope</p>
        <h4>
          Creative Director<br>
          UIUX Designer <br>
          Game Designer <br>
          Solo Dev<br>
        </h4>
      </div>
      <div>
        <p class="label">Skills</p>
        <h4>
          Visual Identity<br/>
          Experiential Designer<br/>
          Game Design<br/>
          Creative Technology<br/>
        </h4>
      </div>
      <div>
        <p class="label">Duration</p>
        <h4>6 weeks</h4>
      </div>
      <div>
        <p class="label">Team</p>
        <h4>Solo</h4>
      </div>
    </div>
    <div class="p-section-open">  
      <p>
        Like air hockey meets the MCU — players physically control projected Marvel heroes on a shared table to take down Doctor Doom and his army of Doombots.
      </p>
    </div>
  </header>

  <!-- HERO -------------------------------------------------->
  <div class="p-media">
    <video autoplay loop muted playsinline>
      <source src="/images/Marvel/OverallShot.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- PROBLEM ---------------------------------------------->
  <section id="problem">
    <hr class="p-divider" />
    <div class="p-section-open">
      <p class="label">Problem</p>
      <h2>MCU fans aren't equally prepped for games.</h2>
      <p>
        The onset of Marvel Rivals marks a major demographic shift in entertainment towards gamers,
        yet Marvel's most loyal fans are suited for the cinema and are at risk of being left behind.
      </p>
    </div>

    <div class="p-media-2col">
      <img src="/images/Marvel/Market/Process_01.png" alt="Exterior of the Fracture pop-up dome" />
      <img src="/images/Marvel/Market/Process_02.png" alt="Exterior of the Fracture pop-up dome" />
    </div>
  </section>

  <!-- OPPORTUNITY ------------------------------------------>
  <section id="opportunity">
    <hr class="p-divider" />
    <div class="p-section-open">
      <p class="label">Opportunity</p>
      <h2>Bringing gaming to non-gamers.</h2>
      <p>
        Creating an experience that introduces MCU fans to the excitement of online gaming —
        without the skill barriers — through Marvel's IP. By meeting cinematic fans where they
        already are, this pop-up partners with theaters nationwide to deliver an immersive
        phygital gaming experience tied to the current Marvel release.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/Aarnav_exteriorfull_people.png" alt="Exterior of the Fracture pop-up dome" />
      <p class="caption">Exterior of the Fracture pop-up dome experience at a movie theater.</p>
    </div>
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/OnTableOptimized.mp4" type="video/mp4" />
      </video>
      <p class="caption">Immersive gaming table that invites 3 players at a time.</p>
    </div>

    <div class="p-media-2col">
      <div>
        <img src="/images/Marvel/AIPath.png" alt="Scene 1" />
        <p class="caption">1. Players illuminate projected paths as Marvel characters.</p>
      </div>
      <div>
        <img src="/images/Marvel/3VBot.png" alt="Scene 2" />
        <p class="caption">2. Players end up at different game tables with grabbable controllers.</p>
      </div>
      <div>
        <img src="/images/Marvel/2v2Table.png" alt="Scene 3" />
        <p class="caption">3. The room creates unique teams based on each player's character</p>
      </div>
      <div>
        <img src="/images/Marvel/ExitWPeople.png" alt="Scene 4" />
        <p class="caption">4. Players leave the game dome.</p>
      </div>
    </div>
  </section>

  <!-- CONCEPT ---------------------------------------------->
  <section id="concept">
    <hr class="p-divider" />
    <div class="p-section-open">
      <p class="label">Concept</p>
      <h2>When Heroes Cross Paths, Sparks Fly.</h2>
      <p>
        Designed for three players against an AI enemy, this timed bullet-hell game balances
        teamwork and individual skill. Each session delivers an intimate yet dynamic experience,
        uniquely shaped by characters and teammates.
      </p>
    </div>

    <div class="p-media">
      <iframe
        class="youtube-embed"
        src="https://www.youtube.com/embed/t9i5VztCyA8"
        title="Fracture gameplay"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <!-- GAME DESIGN ------------------------------------------>
  <section id="game-design">
    <hr class="p-divider" />
    <div class="p-section-open">
      <p class="label">Game Design Overview</p>
      <h2>Designed for gamers of all skill-levels.</h2>
      <p>
        A curated user experience that onboards a player into the game's rules, mechanics, and
        gameplay, incorporating fans' favorite characters and lore from the MCU.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/GameMap.png" alt="Game map overview" />
    </div>
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/UIHighlights_Optimized.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <!-- FEATURES --------------------------------------------->

  <section id="features">
    <hr class="p-divider" />
    <div class="p-section-open">
      <p class="label">Feature 1</p>
      <h2>Shatter the enemy with your Chronoshard</h2>
      <p>
        Players' devices are enveloped in a Chronoshard, a piece from the broken multiverse, which
        they push around to shatter invading Doombots.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/UIZoom1.png" alt="Chronoshard UI" />
    </div>
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/HeroAttempt1.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="p-detail">
      <p class="label">Feature 2</p>
      <h3>Dodge and destroy an army of Doombots.</h3>
      <p>
        Dr. Doom and his future self have teamed up to wreak havoc across the multiverse, releasing
        waves of Doombots with different abilities: a homing bot, a sharp shooter, and an AOE spawner.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/BossOverall.png" alt="Boss overview" />
    </div>
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/BossesOptimized.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="p-detail">
      <p class="label">Feature 3</p>
      <h3>Assemble with your teammates.</h3>
      <p>
        Assemble other players to unleash combined powers unique to your heroes and take down all
        Doombots in the vicinity.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/CollabStill.png" alt="Collab still" />
    </div>
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/CollabOptimized.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="p-detail">
      <p class="label">Feature 4</p>
      <h3>Preserve your health & beat the clock.</h3>
      <p>
        Each player gets immediate visual feedback on their Nexus, a custom UI system that displays
        health, power-ups, score, and time remaining.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/UIZoom2.png" alt="Nexus UI" />
    </div>
    <div class="p-media">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/UIOptimized.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="p-detail">
      <p class="label">Feature 5</p>
      <h3>Emergent dialogue for richer narratives.</h3>
      <p>
        Using OpenAI, the game generates situational dialogue and conversations based on character
        lore and in-game stats, sparking unique narratives across the MCU.
      </p>
    </div>

    <div class="p-media">
      <img src="/images/Marvel/AI_Scenario1.png" alt="AI dialogue scenario" />
    </div>
  </section>

  <!-- PROCESS ---------------------------------------------->

  <section id="process">
    <hr class="p-divider" />
    <div class="p-section-open">
      <p class="label">Process</p>
      <h2>Ideating a non-gamer-friendly experience.</h2>
      <p>
        The process aimed to translate the joys of online gaming into in-person play. These tenets
        were: finding your character, forming a team, and completing a mission.
      </p>
    </div>

    <div class="p-media-3col">
      <img src="/images/Marvel/Process/Process_01.png" alt="Process">
      <img src="/images/Marvel/Process/Process_02.JPG" alt="Process">
      <img src="/images/Marvel/Process/Process_03.png" alt="Process">
      <img src="/images/Marvel/Process/Process_04.JPG" alt="Process">
      <img src="/images/Marvel/Process/Process_05.png" alt="Process">
      <video autoplay loop muted playsinline>
        <source src="/images/Marvel/Prototyping/Process_03.mp4" type="video/mp4" />
      </video>
    </div>

  </section>

</ProjectLayout>

<style>
  .youtube-embed {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
  }
</style>
