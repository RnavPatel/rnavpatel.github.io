---
/**
 * index.astro  →  aarnavpatel.com/
 * ============================================================
 * Homepage: project gallery grid.
 *
 * MARGIN NOTE:
 *   Horizontal margins come from BaseLayout.astro → "Page margin grid".
 *   To change page margins: edit --page-padding-x in tokens.css.
 *
 * GALLERY: layout   → src/components/CardGallery.astro
 *          columns  → --gallery-cols / --col-unit in tokens.css
 * ============================================================
 *
 * To add a project:          edit src/data/projects.ts
 * To change card appearance: edit src/components/ProjectCard.astro
 * To change the gallery:     edit src/components/CardGallery.astro
 * To change card size/shape: edit size: "square"|"wide" in projects.ts
 * To change colors/sizes:    edit src/styles/tokens.css
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CardGallery from "../components/CardGallery.astro";
import { projects } from "../data/projects";

// Name shown in the nav's "Back to:" link on pages under this one (Nav.astro).
export const navTitle = "Home";
---

<BaseLayout title="Aarnav Patel">

  <p class="intro">
    Aarnav is a product designer who makes joyful interactive experiences across entertainment and education platforms.
  </p>

  <!-- =============================================
       GALLERY — layout lives in CardGallery.astro.
       To reorder cards: reorder objects in projects.ts.
       To add a card: add an object in projects.ts.
       ============================================= -->
  <CardGallery>
    {projects.map((project) => (
      <ProjectCard
        title={project.title}
        subtitle={project.subtitle}
        tags={project.tags}
        href={project.href}
        image={project.image}
        mediaType={project.mediaType}
        size={project.size}
        locked={project.locked}
        status={project.status}
      />
    ))}
  </CardGallery>

</BaseLayout>

<style>
  /* INTRO — top-left, 1 gallery column wide (--col-unit, tokens.css).
     Change N to span more columns:
       2 col → calc(2 * var(--col-unit) + 1 * var(--gap-grid))
       3 col → calc(3 * var(--col-unit) + 2 * var(--gap-grid))
     padding-left = the card's own padding (--gap-grid), so the text's
     left edge lines up with the first image's left edge below. */
  .intro {
    width: var(--col-unit);
    padding-left: var(--gap-grid);
    padding-bottom: var(--space-5);
  }

  @media (max-width: 600px) {
    .intro {
      width: 80%;
    }
  }
</style>
