---
/**
 * index.astro  →  aarnavpatel.com/
 * ============================================================
 * Homepage: hero intro text + asymmetric project gallery grid.
 *
 * MARGIN NOTE:
 *   Horizontal margins are NOT set here. They come from the
 *   layout grid defined in BaseLayout.astro → "Page margin grid".
 *   To change page margins: edit --page-padding-x in tokens.css.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "HERO"          → the intro text at the top of the page
 *   "Hero headline" → the big title text and its highlighted word
 *   "Hero meta"     → the small right-side links (Feral Cat Den, CMU, Contact)
 *   "GALLERY GRID"  → the project tile grid
 *   "Grid columns"  → how wide each column is (the fr numbers)
 *   "Grid rows"     → how tall each row is (the px numbers)
 *   "Grid areas"    → which card goes where (the visual map)
 *   "Tablet grid"   → grid at medium screen widths
 *   "Mobile grid"   → grid at small screen widths
 * ============================================================
 *
 * To add a project:          edit src/data/projects.ts
 * To change card appearance: edit src/components/ProjectCard.astro
 * To change colors/sizes:    edit src/styles/tokens.css
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Work" activePage="work">

  <!-- =============================================
       HERO
       Sits in the content column (has page margins).
       To change text: edit the elements below.
       ============================================= -->
  <section class="hero">

    <!-- Hero headline -->
    <h1 class="hero-headline">
      An <em>experience designer</em><br />crafting the future of<br />interactive entertainment.
      <!--    ↑ <em> makes this phrase black. Everything else is gray. -->
    </h1>

    <!-- Hero meta (right side) -->
    <div class="hero-meta">
      <p>
        Previously @ <a href="https://feralcatden.com/#work" target="_blank" rel="noopener" class="link">Feral Cat Den</a>↗<br />
        Graduated from <a href="https://design.cmu.edu" target="_blank" rel="noopener" class="link">CMU Design</a>↗<br />
        <a href="/about" class="link">Contact</a>↗
      </p>
    </div>

  </section>

  <!-- =============================================
       GALLERY GRID
       Also in the content column — aligned to same
       margins as the hero text above it.

       To make it full-bleed (edge-to-edge) instead,
       add class="full-bleed" to this <section>.

       To reorder cards: change gridArea in projects.ts
       ============================================= -->
  <section class="gallery">
    {projects.map((project) => (
      <ProjectCard
        title={project.title}
        tags={project.tags}
        href={project.href}
        image={project.image}
        mediaType={project.mediaType}
        gridArea={project.gridArea}
      />
    ))}
  </section>

  <footer class="footer">
    <p class="text-xs text-muted">Built in Astro</p>
  </footer>

</BaseLayout>

<style>
  /* =============================================
     HERO layout
     No horizontal padding here — the layout grid
     in BaseLayout provides the page margins.
     ============================================= */
  .hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
  }

  /* Hero headline — the large left text */
  .hero-headline {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-text-secondary);
    max-width: 18ch;
  }

  .hero-headline em {
    font-style: normal;
    color: var(--color-text-primary);   /* black for the emphasized phrase */
  }

  /* Hero meta — the small right-side links */
  .hero-meta {
    padding-top: var(--space-2);
    flex-shrink: 0;
  }

  .hero-meta p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-loose);
  }

  /* =============================================
     GALLERY GRID
     CSS Grid with named areas — like naming frames in Figma.
     No horizontal padding — same margin column as hero above.

     Grid columns: width ratio of each column.
       Change these numbers to adjust column widths.
       "2.5fr 4fr 3.5fr" = narrow / wide / medium

     Grid rows: fixed height per row.
       Increase to make all cards taller.

     Grid areas: the visual map — matches gridArea in projects.ts
       "card1 card2 card3"  = row 1
       "card4 card5 card5"  = row 2 (card5 spans 2 cols)
     ============================================= */
  .gallery {
    display: grid;

    /* Grid columns */
    grid-template-columns: 2.5fr 4fr 3.5fr;

    /* Grid rows */
    grid-template-rows: 340px 400px;

    /* Grid areas — the visual map */
    grid-template-areas:
      "card1 card2 card3"
      "card4 card5 card5";

    gap: var(--gap-grid);
  }

  /* =============================================
     Tablet grid  (901px – 1200px)
     Same layout, shorter rows.
     ============================================= */
  @media (min-width: 901px) and (max-width: 1200px) {
    .gallery {
      grid-template-rows: 260px 300px;
    }
  }

  /* =============================================
     Mobile grid  (≤ 900px)
     Single column, cards stack vertically.
     Each card gets a 16:9 aspect ratio.
     ============================================= */
  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      gap: var(--space-5);
    }

    .hero-headline {
      max-width: 100%;
    }

    .gallery {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      grid-template-areas:
        "card1"
        "card2"
        "card3"
        "card4"
        "card5";
    }

    .gallery > :global(.card) {
      aspect-ratio: 16 / 9;
    }
  }

  /* =============================================
     Footer
     ============================================= */
  .footer {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    justify-content: flex-end;
  }
</style>
