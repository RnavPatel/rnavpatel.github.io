---
/**
 * index.astro  →  aarnavpatel.com/
 * ============================================================
 * Homepage: project gallery grid.
 *
 * MARGIN NOTE:
 *   Horizontal margins come from BaseLayout.astro → "Page margin grid".
 *   To change page margins: edit --page-padding-x in tokens.css.
 *
 * CHEAT SHEET — CMD+F these labels:
 *   "GALLERY GRID"  → the project tile grid
 *   "Grid columns"  → 4-column definition
 *   "Grid areas"    → the visual map (which card goes where)
 *   "Grid stagger"  → why row 2 is offset right (the empty cell)
 *   "Tablet grid"   → grid at medium screen widths
 *   "Mobile grid"   → single-column layout for phones
 * ============================================================
 *
 * To add a project:          edit src/data/projects.ts
 * To change card appearance: edit src/components/ProjectCard.astro
 * To change card size/shape: edit size: "square"|"wide" in projects.ts
 * To change colors/sizes:    edit src/styles/tokens.css
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Work" activePage="work">

  <!-- =============================================
       GALLERY GRID
       Sits in the content column (has page margins).
       Cards define their OWN size via aspect-ratio —
       the grid places them, not stretches them.

       To go full-bleed (edge-to-edge):
         add class="full-bleed" to this <section>
       ============================================= -->
  <section class="gallery">
    {projects.map((project) => (
      <ProjectCard
        title={project.title}
        tags={project.tags}
        href={project.href}
        image={project.image}
        mediaType={project.mediaType}
        size={project.size}
        gridArea={project.gridArea}
      />
    ))}
  </section>

  <footer class="footer">
    <p class="text-xs text-muted">Built in Astro</p>
  </footer>

</BaseLayout>

<style>
  /* =============================================
     GALLERY GRID
     =============================================

     Grid columns: 4 equal columns.
       Wide cards span 2 columns (set in ProjectCard via grid-area).
       Square cards span 1 column.

     Grid areas: the visual layout map.
       Each string is one row. Each word is one cell.
       "." = intentionally empty cell.

       Row 1:  card1 | card2 (wide) | card2 | card3
       Row 2:  empty | card4        | card5 (wide) | card5

       The empty cell in row 2 staggers it right —
       card4 aligns with where card2 starts above it.
       This creates the asymmetric offset from the mockup.

     NO fixed row heights — card aspect-ratios determine height.
       square cards: 1:1
       wide cards:   2:1  (same height as a square in the same row)

     align-items: start ensures cards are NOT stretched to
     fill row height — they hold their own aspect ratio.
  =============================================*/
  .gallery {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
    display: grid;

    /* Grid columns: 4 equal units */
    grid-template-columns: repeat(4, 1fr);

    /* Grid areas — the visual map
       Edit this to rearrange the layout.
       Match gridArea values in projects.ts. */
    grid-template-areas:
      "card1 card2 card2 card3"
      ".     card4 card5 card5";

    gap: var(--gap-grid);

    /* Cards hold their own aspect ratio — don't stretch them */
    align-items: start;
  }

  /* =============================================
     Tablet grid  (700px – 1100px)
     Keep 2-column layout but drop the stagger.
     Row 1: square + wide
     Row 2: wide + square
     ============================================= */
  @media (min-width: 700px) and (max-width: 1100px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas:
        "card1 card2"
        "card3 card4"
        "card5 card5";
      /* card5 (wide) spans full width of the 2-col grid on tablet */
    }

    /* wide cards span 1 column at this size — 2:1 becomes too wide */
    /* Override aspect ratio so wide cards match square cards' height */
    .gallery > :global(.card--wide) {
      aspect-ratio: 1 / 1;
    }

    /* card5 full-width gets its proper wide ratio back */
    .gallery > :global([style*="card5"]) {
      aspect-ratio: 2 / 1;
    }
  }

  /* =============================================
     Mobile grid  (≤ 700px)
     Single column. ALL cards become 16:9.
     "square" type is overridden to 16:9 too —
     small squares look awkward stacked full-width.
     ============================================= */
  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr;
      grid-template-areas:
        "card1"
        "card2"
        "card3"
        "card4"
        "card5";
      align-items: stretch;
    }

    /* All cards → 16:9 on mobile regardless of desktop size */
    .gallery > :global(.card--square),
    .gallery > :global(.card--wide) {
      aspect-ratio: 16 / 9;
    }
  }

  /* =============================================
     Footer
     ============================================= */
  .footer {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    justify-content: flex-end;
  }
</style>
